    rdfs:range cmv:AssumptionBasis ;
    rdfs:comment "TOTAL (default): value is the total for time_period, spread across its months. RATE: value applies to every month unchanged (use for rates and shares such as a re-issue rate)."@en ;
    cm:fieldName "basis" ;
    cm:required "false"^^xsd:boolean ;
