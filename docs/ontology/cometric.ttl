    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-029" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"CLM, ELM and workflow deployments and ongoing operation.\", \"formula\": null, \"provider_client_economics\": \"Supports recovery of setup investment separately from run economics.\", \"source_basis\": [\"BB-MILESTONE\", \"BB-FIXED\", \"BB-RECURRING\"]}"^^rdf:JSON .

pack-base:PM-030 a skos:Concept ;
    skos:notation "PM-030" ;
    skos:prefLabel "AI or automation consumption"@en ;
    skos:altLabel "AI consumption pricing"@en, "per-prompt pricing"@en ;
