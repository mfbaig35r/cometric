pack-base:COMPAT-001 a cm:Rule ;
    skos:notation "COMPAT-001" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_CAPACITY_PLUS_OVERAGE" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Capacity reservation combined with usage overage is a structurally valid combination."@en ;
    cm:explanation "The base payment buys readiness and excess consumption can be separately metered; cloud commitment models demonstrate analogous economics."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"RESERVED_CAPACITY\", \"path\": \"arrangement_versions[*].commitments[*].kind\"}, {\"equals\": \"CAPACITY\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}]}, {\"equals\": \"ALLOWANCE_OVERAGE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0008, pack-base:CLM-B-0009 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-002 a cm:Rule ;
    skos:notation "COMPAT-002" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_FIXED_MANAGED_PLUS_SLA_CREDITS" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A fixed-fee managed service with SLA credits is a structurally valid combination."@en ;
    cm:explanation "The base fee and the performance remedy address different dimensions."@en ;
    cm:condition "{\"all\": [{\"equals\": \"FIXED_RECURRING\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"equals\": \"SLA_CREDIT\", \"path\": \"arrangement_versions[*].adjustments[*].type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-003 a cm:Rule ;
    skos:notation "COMPAT-003" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_FIXED_MANAGED_PLUS_BONUS" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A fixed-fee managed service with a performance bonus is structurally valid if the bonus metric is measurable."@en ;
    cm:explanation "Fixed core economics are combined with an upside incentive; the metric must be measurable."@en ;
    cm:condition "{\"all\": [{\"equals\": \"FIXED_RECURRING\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"equals\": \"BONUS\", \"path\": \"arrangement_versions[*].adjustments[*].type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-004 a cm:Rule ;
    skos:notation "COMPAT-004" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "CONDITIONALLY_PREFERRED" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_UNIT_PLUS_COMPLEXITY" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Complexity-adjusted unit pricing is conditionally preferred where unit cost variance is material and objectively classifiable."@en ;
    cm:explanation "Appropriate where unit cost variance is material and objectively classifiable."@en ;
    cm:condition "{\"any\": [{\"equals\": \"WEIGHTED_UNIT_OUTPUT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"equals\": \"COMPLEXITY_WEIGHTED\", \"path\": \"descriptors.rate_structure\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0051 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-005 a cm:Rule ;
    skos:notation "COMPAT-005" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID_BUT_LIABILITY_SHIFTING" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_COMMITMENT_PLUS_ROLLOVER" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A minimum commitment with rollover defers the delivery obligation; review future capacity concentration."@en ;
    cm:explanation "Rollover improves fairness but defers the delivery obligation and can cause future capacity concentration."@en ;
    cm:condition "{\"all\": [{\"in\": [\"MINIMUM_SPEND\", \"MINIMUM_VOLUME\"], \"path\": \"arrangement_versions[*].commitments[*].kind\"}, {\"in\": [\"NEXT_PERIOD\", \"TERM\"], \"path\": \"arrangement_versions[*].entitlements[*].rollover.policy\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-006 a cm:Rule ;
    skos:notation "COMPAT-006" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_COMMITMENT_PLUS_TRANSFERABLE_CREDITS" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A commitment with credits transferable across a service catalog is a structurally valid combination."@en ;
    cm:explanation "Demonstrated by at least one provider's multi-service credit subscription."@en ;
    cm:condition "{\"all\": [{\"equals\": \"PREPAID_CREDIT\", \"path\": \"arrangement_versions[*].commitments[*].kind\"}, {\"equals\": \"CATALOG\", \"path\": \"descriptors.scope\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-007 a cm:Rule ;
    skos:notation "COMPAT-007" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "ECONOMICALLY_CONFLICTING" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "COMPAT_GAIN_SHARE_VS_BUDGET_CERTAINTY" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Gain-share conflicts with strict budget predictability unless the outcome-dependent amount is capped."@en ;
    cm:explanation "Outcome-dependent consideration creates variability unless capped."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0006 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-008 a cm:Rule ;
    skos:notation "COMPAT-008" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_WEAK" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "COMPAT_OUTCOME_FEE_UNMEASURABLE_RESULT" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "An outcome fee tied to an unmeasurable business result is structurally weak."@en ;
    cm:explanation "Baseline, attribution and controllability problems make enforcement and economics uncertain."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0041 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-009 a cm:Rule ;
    skos:notation "COMPAT-009" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "ECONOMICALLY_UNATTRACTIVE_TO_PROVIDER" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_UNLIMITED_FIXED_UNBOUNDED_DEMAND" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A fixed fee over variable, unbounded demand creates an uncapped provider obligation; review volume limits."@en ;
    cm:explanation "Creates a theoretically uncapped marginal obligation without corresponding revenue."@en ;
    cm:condition "{\"all\": [{\"in\": [\"FIXED_RECURRING\", \"FIXED_PROJECT\"], \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"not\": {\"equals\": \"ALLOWANCE_OVERAGE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}}, {\"not\": {\"equals\": \"COLLAR\", \"path\": \"arrangement_versions[*].adjustments[*].type\"}}, {\"equals\": \"VARIABLE\", \"path\": \"descriptors.scope\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0049 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-010 a cm:Rule ;
    skos:notation "COMPAT-010" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_DEDICATED_PLUS_USE_IT_OR_LOSE_IT" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Dedicated resources with use-it-or-lose-it entitlement are structurally valid but carry value-perception risk at low usage."@en ;
    cm:explanation "The client purchases resource availability, but low usage generates value-perception risk."@en ;
    cm:condition "{\"all\": [{\"equals\": \"DEDICATED_RESOURCE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"equals\": \"NONE\", \"path\": \"arrangement_versions[*].entitlements[*].rollover.policy\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0048 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-011 a cm:Rule ;
    skos:notation "COMPAT-011" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "CONDITIONALLY_VALID" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_POOLED_PLUS_HARD_CAPACITY_GUARANTEE" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A hard capacity guarantee on pooled delivery requires portfolio capacity reserves; review capacity planning."@en ;
    cm:explanation "Requires portfolio capacity reserves; cannot be assumed from pooling alone."@en ;
    cm:condition "{\"all\": [{\"equals\": \"POOLED\", \"path\": \"delivery_plan.topology\"}, {\"equals\": \"RESERVED_CAPACITY\", \"path\": \"arrangement_versions[*].commitments[*].kind\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-012 a cm:Rule ;
    skos:notation "COMPAT-012" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_VALID_BUT_INCENTIVE_SENSITIVE" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_AUTOMATION_PLUS_HOURLY" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Hourly billing of an automated service is incentive-sensitive; review whether rates or value architecture should change."@en ;
    cm:explanation "Efficiency lowers billable hours unless rates or value architecture change."@en ;
    cm:condition "{\"all\": [{\"exists\": true, \"path\": \"descriptors.automation_benefit\"}, {\"equals\": \"TIME\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0032 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-013 a cm:Rule ;
    skos:notation "COMPAT-013" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "STRUCTURALLY_ATTRACTIVE" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMPAT_AUTOMATION_PLUS_FIXED_OR_OUTPUT" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Automation priced on a fixed or output basis is structurally attractive to the provider."@en ;
    cm:explanation "The provider can retain productivity upside until competition or contract terms pass savings through."@en ;
    cm:condition "{\"all\": [{\"exists\": true, \"path\": \"descriptors.automation_benefit\"}, {\"in\": [\"FIXED_RECURRING\", \"FIXED_PROJECT\", \"UNIT_OUTPUT\", \"WEIGHTED_UNIT_OUTPUT\"], \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0033 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-014 a cm:Rule ;
    skos:notation "COMPAT-014" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "NOT_ECONOMICALLY_DEFENSIBLE" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "COMPAT_SHARED_SAVINGS_NO_BASELINE" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Shared savings without an agreed baseline cannot be verified; review baseline terms."@en ;
    cm:explanation "Savings cannot be verified without a counterfactual or baseline."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-015 a cm:Rule ;
    skos:notation "COMPAT-015" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "NOT_VALID_FOR_RIGOROUS_MODELING" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "COMPAT_INCENTIVE_UNDEFINED_OBLIGATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A performance incentive without a defined performance obligation cannot be modeled rigorously."@en ;
    cm:explanation "Incentive calculation requires a metric, target, measurement period and attribution."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:COMPAT-016 a cm:Rule ;
    skos:notation "COMPAT-016" ;
    cm:pack pack-base:pack ;
    cm:kind "compatibility" ;
    cm:assessment "POTENTIALLY_DISPROPORTIONATE" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "COMPAT_SLA_CREDITS_UNLIMITED_LIABILITY" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "SLA credits alongside unlimited liability may be disproportionate; contract review is required."@en ;
    cm:explanation "The contract must address the interaction between exclusive remedies, credits and damages; enforceability depends on governing law."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0042 ;
    cm:sourceRef "report:compatibility-rules" .

pack-base:RULE-001 a cm:Rule ;
    skos:notation "RULE-001" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_RESERVED_COST_PERSISTS" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Guaranteed capacity is present; reserved delivery cost may persist even if consumption is zero."@en ;
    cm:explanation "Where capacity is guaranteed, reserved delivery cost may persist even if consumption falls to zero."@en ;
    cm:condition "{\"any\": [{\"equals\": \"RESERVED_CAPACITY\", \"path\": \"arrangement_versions[*].commitments[*].kind\"}, {\"equals\": \"DEDICATED_RESOURCE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"equals\": \"CAPACITY\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:claim pack-base:CLM-B-0048 ;
    cm:sourceRef "report:RULE-001" .

pack-base:RULE-002 a cm:Rule ;
    skos:notation "RULE-002" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_COMPLEXITY_NORMALIZATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Unit cost appears to vary by complexity; unadjusted unit pricing can create adverse-selection or margin risk."@en ;
    cm:explanation "Where unit cost materially differs by complexity, unadjusted unit pricing can create adverse-selection and margin risk; consider complexity normalization."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0051 ;
    cm:sourceRef "report:RULE-002" .

pack-base:RULE-003 a cm:Rule ;
    skos:notation "RULE-003" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_INCENTIVE_PREREQUISITES" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A performance incentive is present; its metric, target, measurement window and attribution method must be defined before it can be calculated."@en ;
    cm:explanation "A metric, target, measurement window and attribution method must exist before deterministic calculation of a performance incentive."@en ;
    cm:condition "{\"in\": [\"BONUS\", \"HOLDBACK\"], \"path\": \"arrangement_versions[*].adjustments[*].type\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:RULE-003" .

pack-base:RULE-004 a cm:Rule ;
    skos:notation "RULE-004" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_SHARED_SAVINGS_PREREQUISITES" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Outcome-linked consideration is present; a baseline and attribution method are prerequisites."@en ;
    cm:explanation "Shared savings and other outcome-linked fees require a baseline and attribution method."@en ;
    cm:condition "{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:claim pack-base:CLM-B-0006 ;
    cm:sourceRef "report:RULE-004" .

pack-base:RULE-005 a cm:Rule ;
    skos:notation "RULE-005" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_FIXED_FEE_UNBOUNDED_DEMAND" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A fixed fee has no overage or collar and no declared fixed scope; review whether demand is bounded."@en ;
    cm:explanation "Fixed fee with unbounded demand gives the provider potentially unbounded cost exposure; a cap, collar, overage or change mechanism should be considered."@en ;
    cm:condition "{\"all\": [{\"in\": [\"FIXED_RECURRING\", \"FIXED_PROJECT\"], \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"not\": {\"equals\": \"ALLOWANCE_OVERAGE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}}, {\"not\": {\"equals\": \"COLLAR\", \"path\": \"arrangement_versions[*].adjustments[*].type\"}}, {\"not\": {\"equals\": \"FIXED\", \"path\": \"descriptors.scope\"}}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0049 ;
    cm:sourceRef "report:RULE-005" .

pack-base:RULE-006 a cm:Rule ;
    skos:notation "RULE-006" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_COMMITMENT_UNUSED_ENTITLEMENT" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A minimum commitment is present; if entitlement goes unused, provider revenue may hold while client unit value deteriorates."@en ;
    cm:explanation "With a minimum commitment and unused entitlement, provider revenue may remain intact while the client's realized unit value deteriorates."@en ;
    cm:condition "{\"in\": [\"MINIMUM_SPEND\", \"MINIMUM_VOLUME\", \"PREPAID_CREDIT\"], \"path\": \"arrangement_versions[*].commitments[*].kind\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0046 ;
    cm:sourceRef "report:RULE-006" .

pack-base:RULE-007 a cm:Rule ;
    skos:notation "RULE-007" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_ROLLOVER_FUTURE_OBLIGATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Rollover is permitted; unused entitlement becomes a future delivery obligation and capacity exposure."@en ;
    cm:explanation "Rolled-over entitlement creates a future delivery obligation and capacity exposure."@en ;
    cm:condition "{\"in\": [\"NEXT_PERIOD\", \"TERM\"], \"path\": \"arrangement_versions[*].entitlements[*].rollover.policy\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:RULE-007" .

pack-base:RULE-008 a cm:Rule ;
    skos:notation "RULE-008" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_DEDICATED_COST_STICKY" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Dedicated resources are present; low demand does not necessarily reduce direct cost proportionally."@en ;
    cm:explanation "With dedicated resources, low demand does not necessarily reduce direct cost proportionally."@en ;
    cm:condition "{\"any\": [{\"equals\": \"DEDICATED\", \"path\": \"delivery_plan.topology\"}, {\"equals\": \"DEDICATED_RESOURCE\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:claim pack-base:CLM-B-0048 ;
    cm:sourceRef "report:RULE-008" .

pack-base:RULE-009 a cm:Rule ;
    skos:notation "RULE-009" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_POOLED_REDEPLOYMENT" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Pooled delivery is declared; under low client demand the provider may redeploy resources, so incremental cost can fall further than under a dedicated model."@en ;
    cm:explanation "With pooled resources and low client demand, the provider may redeploy resources, so incremental cost can fall more than under a dedicated model."@en ;
    cm:condition "{\"equals\": \"POOLED\", \"path\": \"delivery_plan.topology\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:RULE-009" .

pack-base:RULE-010 a cm:Rule ;
    skos:notation "RULE-010" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_HOURS_NOT_VALUE_PROXY" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Automation is declared; labor hours alone are not a sufficient cost or value proxy."@en ;
    cm:explanation "Where AI reduces human hours, labor hours alone cease to be a sufficient cost or value proxy."@en ;
    cm:condition "{\"exists\": true, \"path\": \"descriptors.automation_benefit\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:claim pack-base:CLM-B-0030, pack-base:CLM-B-0032 ;
    cm:sourceRef "report:RULE-010" .

pack-base:RULE-013 a cm:Rule ;
    skos:notation "RULE-013" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_ADVANCE_BILLING_NOT_REVENUE" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Revenue billed in advance does not automatically equal recognized revenue."@en ;
    cm:explanation "Billed cash or a receivable does not automatically equal recognized revenue under IFRS 15 or ASC Topic 606."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-base:CLM-B-0013 ;
    cm:sourceRef "report:RULE-013" .

pack-base:RULE-014 a cm:Rule ;
    skos:notation "RULE-014" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_OVERFLOW_MUST_BE_MODELED" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Demand may exceed normal capacity; overflow cost or SLA degradation must be modeled."@en ;
    cm:explanation "When demand exceeds normal capacity, overflow cost or SLA degradation must be modeled."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0026 ;
    cm:sourceRef "report:RULE-014" .

pack-base:RULE-015 a cm:Rule ;
    skos:notation "RULE-015" ;
    cm:pack pack-base:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_SAVINGS_CLAIM_TOTAL_COST" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A savings claim should include transition, technology, governance and QA costs before total economics are compared."@en ;
    cm:explanation "When a provider claims savings, transition, technology, governance and QA costs should be included before comparing total economics."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:RULE-015" .

pack-base:COMP-001 a cm:Rule ;
    skos:notation "COMP-001" ;
    cm:pack pack-base:pack ;
    cm:kind "composition" ;
    cm:assessment "ECONOMICALLY_CONFLICTING" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMP_DOUBLE_VOLUME_REDUCTION" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Volume bands and a volume discount or rebate reduce the price for the same volume twice."@en ;
    cm:explanation "Banded unit prices already lower the price as volume grows; a discount or rebate on top rewards the same volume a second time."@en ;
    cm:condition "{\"all\": [{\"equals\": \"PM-014\", \"path\": \"base_model\"}, {\"in\": [\"CL-V04\", \"CL-V05\"], \"path\": \"levers[*]\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:COMP-002 a cm:Rule ;
    skos:notation "COMP-002" ;
    cm:pack pack-base:pack ;
    cm:kind "composition" ;
    cm:assessment "ECONOMICALLY_CONFLICTING" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMP_DOUBLE_SHORTFALL_PROTECTION" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A volume collar and a minimum commitment both protect the provider against a shortfall; keep one."@en ;
    cm:explanation "Both terms move shortfall risk to the client; together they charge for the same missing volume twice."@en ;
    cm:condition "{\"all\": [{\"equals\": \"CL-V08\", \"path\": \"levers[*]\"}, {\"equals\": \"CL-R01\", \"path\": \"levers[*]\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:COMP-003 a cm:Rule ;
    skos:notation "COMP-003" ;
    cm:pack pack-base:pack ;
    cm:kind "composition" ;
    cm:assessment "ECONOMICALLY_CONFLICTING" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMP_DISCOUNT_AND_REBATE" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A volume discount and a volume rebate reward the same spend twice."@en ;
    cm:explanation "Use one volume incentive per charge."@en ;
    cm:condition "{\"all\": [{\"equals\": \"CL-V04\", \"path\": \"levers[*]\"}, {\"equals\": \"CL-V05\", \"path\": \"levers[*]\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:COMP-004 a cm:Rule ;
    skos:notation "COMP-004" ;
    cm:pack pack-base:pack ;
    cm:kind "composition" ;
    cm:assessment "ECONOMICALLY_CONFLICTING" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "COMP_ALTERNATIVE_TERMINATION_TERMS" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A termination fee and a prorated minimum are alternative early-exit terms."@en ;
    cm:explanation "Choose one early-exit term."@en ;
    cm:condition "{\"all\": [{\"equals\": \"CL-P14.fee\", \"path\": \"keys[*]\"}, {\"equals\": \"CL-P14.prorated\", \"path\": \"keys[*]\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:CLM-B-0001 a cm:Claim ;
    skos:notation "CLM-B-0001" ;
    cm:pack pack-base:pack ;
    cm:statement "An actual commercial arrangement is better represented as a composition of billing basis, rate structure, commitment, risk allocation, adjustment mechanisms and delivery obligations than as a single pricing model."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:executive-synthesis" .

pack-base:CLM-B-0002 a cm:Claim ;
    skos:notation "CLM-B-0002" ;
    cm:pack pack-base:pack ;
    cm:statement "Billing bases are not mutually exclusive: managed services and capacity reservations combine recurring, output, capacity and usage elements in one arrangement."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E020, pack-base:E023 ;
    cm:sourceRef "report:billing-bases" .

pack-base:CLM-B-0003 a cm:Claim ;
    skos:notation "CLM-B-0003" ;
    cm:pack pack-base:pack ;
    cm:statement "Many apparently innovative commercial structures, including multi-year subscriptions, committed consumption, output pricing, service credits, shared savings and capacity reservation, adapt older outsourcing and professional-services mechanisms."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E020, pack-base:E021, pack-base:E023 ;
    cm:sourceRef "report:executive-synthesis" .

pack-base:CLM-B-0004 a cm:Claim ;
    skos:notation "CLM-B-0004" ;
    cm:pack pack-base:pack ;
    cm:statement "Commercial structure selection is a multi-objective decision problem with rarely one uniquely optimal structure absent assumptions about volume, cost behavior, preferences, risk tolerance, capacity and renewal economics."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:executive-synthesis" .

pack-base:CLM-B-0005 a cm:Claim ;
    skos:notation "CLM-B-0005" ;
    cm:pack pack-base:pack ;
    cm:statement "At least one large advisory firm describes its managed services as multi-year as-a-service subscriptions with predictable cost and outcome-oriented service levels."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E020 ;
    cm:sourceRef "report:PM-010" .

pack-base:CLM-B-0006 a cm:Claim ;
    skos:notation "CLM-B-0006" ;
    cm:pack pack-base:pack ;
    cm:statement "Outcome-based outsourcing guidance describes linking provider compensation to operational results, cost-saving targets and productivity glide paths."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:source pack-base:E021 ;
    cm:sourceRef "report:PM-024" .

pack-base:CLM-B-0007 a cm:Claim ;
    skos:notation "CLM-B-0007" ;
    cm:pack pack-base:pack ;
    cm:statement "Managed-services contracting guidance for generative AI identifies shared cost savings, incentives, data ownership, AI alliances, SLAs and value tracking as commercial-contract considerations."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.EMERGING ;
    cm:source pack-base:E022 ;
    cm:sourceRef "report:ai-economics" .

pack-base:CLM-B-0008 a cm:Claim ;
    skos:notation "CLM-B-0008" ;
    cm:pack pack-base:pack ;
    cm:statement "Cloud marketplace documentation describes committed-use pricing that combines a minimum commitment with usage and overage charges."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E023 ;
    cm:sourceRef "report:MECH-001" .

pack-base:CLM-B-0009 a cm:Claim ;
    skos:notation "CLM-B-0009" ;
    cm:pack pack-base:pack ;
    cm:statement "A large cloud provider's savings plans exchange a spend commitment for discounted rates, with usage above the commitment charged at on-demand rates."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E024 ;
    cm:sourceRef "report:MECH-001" .

pack-base:CLM-B-0010 a cm:Claim ;
    skos:notation "CLM-B-0010" ;
    cm:pack pack-base:pack ;
    cm:statement "A large cloud provider's savings plans commit the customer to hourly spend regardless of actual usage."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E025 ;
    cm:sourceRef "report:MECH-002" .

pack-base:CLM-B-0011 a cm:Claim ;
    skos:notation "CLM-B-0011" ;
    cm:pack pack-base:pack ;
    cm:statement "IFRS 15 requires identifying the contract and its performance obligations, determining and allocating the transaction price, and recognizing revenue when or as obligations are satisfied."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E026 ;
    cm:sourceRef "report:FM-002" .

pack-base:CLM-B-0012 a cm:Claim ;
    skos:notation "CLM-B-0012" ;
    cm:pack pack-base:pack ;
    cm:statement "ASC Topic 606 establishes the analogous US GAAP revenue-recognition framework."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E027 ;
    cm:sourceRef "report:FM-002" .

pack-base:CLM-B-0013 a cm:Claim ;
    skos:notation "CLM-B-0013" ;
    cm:pack pack-base:pack ;
    cm:statement "Revenue recognition under IFRS 15 and ASC Topic 606 is based on performance obligations and transfer of promised services, not invoice timing or receipt of cash."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-base:E026, pack-base:E027 ;
    cm:sourceRef "report:RULE-013" .

pack-base:CLM-B-0014 a cm:Claim ;
    skos:notation "CLM-B-0014" ;
    cm:pack pack-base:pack ;
    cm:statement "One professional-services software vendor defines project gross margin as revenue less labor and direct or reimbursable expenses where overhead is not allocated."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:source pack-base:E038 ;
    cm:sourceRef "report:FM-016" .

pack-base:CLM-B-0015 a cm:Claim ;
    skos:notation "CLM-B-0015" ;
    cm:pack pack-base:pack ;
    cm:statement "The UK financial conduct regulator states that firms remain responsible for managing third-party and outsourcing risk; its July 2026 update to that guidance concerns critical third parties."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E032 ;
    cm:sourceRef "report:outsourcing-constraints" .

pack-base:CLM-B-0016 a cm:Claim ;
    skos:notation "CLM-B-0016" ;
    cm:pack pack-base:pack ;
    cm:statement "The UK financial conduct regulator finalized material third-party reporting rules in March 2026 that take effect on March 18, 2027."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E033 ;
    cm:sourceRef "report:RULE-016" .

pack-base:CLM-B-0017 a cm:Claim ;
    skos:notation "CLM-B-0017" ;
    cm:pack pack-base:pack ;
    cm:statement "The March 2026 update to SS2/21 sets expectations on audit and access rights for material outsourcing arrangements from March 18, 2027."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E034 ;
    cm:sourceRef "report:RULE-016" .

pack-base:CLM-B-0018 a cm:Claim ;
    skos:notation "CLM-B-0018" ;
    cm:pack pack-base:pack ;
    cm:statement "UK prudential outsourcing expectations address exit obligations for material outsourcing arrangements."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E034 ;
    cm:sourceRef "report:CL-P15" .

pack-base:CLM-B-0019 a cm:Claim ;
    skos:notation "CLM-B-0019" ;
    cm:pack pack-base:pack ;
    cm:statement "UK data-protection guidance on AI contracts calls for documented controller and processor roles, due diligence, accuracy KPIs or SLAs, subprocessor controls, security measures, audit rights and end-of-contract data handling."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E035 ;
    cm:sourceRef "report:RULE-011" .

pack-base:CLM-B-0020 a cm:Claim ;
    skos:notation "CLM-B-0020" ;
    cm:pack pack-base:pack ;
    cm:statement "UK financial-services AI good-practice material stresses third-party oversight, visibility into model changes, fallback arrangements, exit options and avoidance of untested vendor assurances."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-base:E036 ;
    cm:sourceRef "report:outsourcing-constraints" .

pack-base:CLM-B-0021 a cm:Claim ;
    skos:notation "CLM-B-0021" ;
    cm:pack pack-base:pack ;
    cm:statement "Fully loaded profitability and incremental contribution answer different questions: a renewal unattractive after overhead allocation may still have positive contribution, and a contributing contract may be unsustainable if the portfolio never covers shared costs."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:cost-allocation" .

pack-base:CLM-B-0022 a cm:Claim ;
    skos:notation "CLM-B-0022" ;
    cm:pack pack-base:pack ;
    cm:statement "Cost categories should not automatically share one allocation method; dedicated idle capacity and pooled portfolio capacity are treated differently."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:cost-allocation" .

pack-base:CLM-B-0023 a cm:Claim ;
    skos:notation "CLM-B-0023" ;
    cm:pack pack-base:pack ;
    cm:statement "Markup is (price - cost) / cost and margin is (price - cost) / price; conflating them is a material pricing error, and a 25% margin implies a 33.33% markup."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:FM-021" .

pack-base:CLM-B-0024 a cm:Claim ;
    skos:notation "CLM-B-0024" ;
    cm:pack pack-base:pack ;
    cm:statement "The minimum sustainable price under a target contribution margin is a decision formula, not a benchmark; the target margin and risk premium must come from internal governance."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:price-floor" .

pack-base:CLM-B-0025 a cm:Claim ;
    skos:notation "CLM-B-0025" ;
    cm:pack pack-base:pack ;
    cm:statement "A unit price derived at one forecast volume can become uneconomic at a lower realized volume because fixed cost is spread across fewer units."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:price-floor" .

pack-base:CLM-B-0026 a cm:Claim ;
    skos:notation "CLM-B-0026" ;
    cm:pack pack-base:pack ;
    cm:statement "Capacity-constrained cost should distinguish normal capacity from demand above it, so high volume is not assumed to be served indefinitely at the same marginal cost."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:capacity-economics" .

pack-base:CLM-B-0027 a cm:Claim ;
    skos:notation "CLM-B-0027" ;
    cm:pack pack-base:pack ;
    cm:statement "Monte Carlo simulation is an analytical extension that should not be mistaken for a prediction unless its distributions are empirically calibrated."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:demand-uncertainty" .

pack-base:CLM-B-0028 a cm:Claim ;
    skos:notation "CLM-B-0028" ;
    cm:pack pack-base:pack ;
    cm:statement "Margin-at-Risk can be defined as target contribution less a chosen quantile of contribution; it is a proposed management measure unless an organization defines it formally."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:demand-uncertainty" .

pack-base:CLM-B-0029 a cm:Claim ;
    skos:notation "CLM-B-0029" ;
    cm:pack pack-base:pack ;
    cm:statement "Client Value-at-Risk, a downside measure of realized value relative to committed spend, lacks sufficient public evidence to be treated as a validated metric."@en ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:demand-uncertainty" .

pack-base:CLM-B-0030 a cm:Claim ;
    skos:notation "CLM-B-0030" ;
    cm:pack pack-base:pack ;
    cm:statement "AI-enabled services should be modeled as a production system with engineering, implementation, platform, infrastructure, inference, validation, exception, QA, monitoring, security, revalidation and migration costs, not as a zero-cost labor replacement."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:ai-economics" .

pack-base:CLM-B-0031 a cm:Claim ;
    skos:notation "CLM-B-0031" ;
    cm:pack pack-base:pack ;
    cm:statement "There is no credible evidence of a universal automation-savings sharing percentage."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:automation-structures" .

pack-base:CLM-B-0032 a cm:Claim ;
    skos:notation "CLM-B-0032" ;
    cm:pack pack-base:pack ;
    cm:statement "Pricing an automation-redesigned service by the remaining human hours prices the input that became scarce rather than the service delivered and could fail to recover technology investment."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:automation-structures" .

pack-base:CLM-B-0033 a cm:Claim ;
    skos:notation "CLM-B-0033" ;
    cm:pack pack-base:pack ;
    cm:statement "Provider-retained automation benefit creates the strongest incentive to invest but may invite competitive repricing."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:automation-benefit" .

pack-base:CLM-B-0034 a cm:Claim ;
    skos:notation "CLM-B-0034" ;
    cm:pack pack-base:pack ;
    cm:statement "Client-retained automation benefit accelerates adoption but can make provider investment unattractive."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:automation-benefit" .

pack-base:CLM-B-0035 a cm:Claim ;
    skos:notation "CLM-B-0035" ;
    cm:pack pack-base:pack ;
    cm:statement "Shared automation benefit can align incentives but increases measurement complexity."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:automation-benefit" .

pack-base:CLM-B-0036 a cm:Claim ;
    skos:notation "CLM-B-0036" ;
    cm:pack pack-base:pack ;
    cm:statement "Productivity glide paths that pass efficiencies through on a contractual schedule have direct precedent in broader outsourcing and managed services."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:source pack-base:E021, pack-base:E022 ;
    cm:sourceRef "report:automation-benefit" .

pack-base:CLM-B-0037 a cm:Claim ;
    skos:notation "CLM-B-0037" ;
    cm:pack pack-base:pack ;
    cm:statement "Bundling technology and service suits a client wanting one business outcome where the provider controls the production stack; unbundling suits volatile consumption, transparency needs, portable licenses or material third-party model costs."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:ai-pricing-architecture" .

pack-base:CLM-B-0038 a cm:Claim ;
    skos:notation "CLM-B-0038" ;
    cm:pack pack-base:pack ;
    cm:statement "Not all client value components are readily monetizable: avoided cost needs a credible counterfactual, risk reduction is probabilistic, availability may never be used, and quality needs normalized defect definitions."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:client-value" .

pack-base:CLM-B-0039 a cm:Claim ;
    skos:notation "CLM-B-0039" ;
    cm:pack pack-base:pack ;
    cm:statement "Commercial-health indicators are management indicators, not validated industry thresholds."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:commercial-health" .

pack-base:CLM-B-0040 a cm:Claim ;
    skos:notation "CLM-B-0040" ;
    cm:pack pack-base:pack ;
    cm:statement "The hypothesis that persistently unused commitments elevate renewal risk is commercially plausible but not established by located public empirical research."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CHI-010" .

pack-base:CLM-B-0041 a cm:Claim ;
    skos:notation "CLM-B-0041" ;
    cm:pack pack-base:pack ;
    cm:statement "Outcome pricing is less transferable where provider controllability is weak, as when results depend on external parties, client decisions, market events or legal judgment."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:adjacent-mechanisms" .

pack-base:CLM-B-0042 a cm:Claim ;
    skos:notation "CLM-B-0042" ;
    cm:pack pack-base:pack ;
    cm:statement "A service credit is not automatically liquidated damages, and liquidated damages are not automatically a penalty; legal characterization depends on the contract and governing law."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:service-credits" .

pack-base:CLM-B-0043 a cm:Claim ;
    skos:notation "CLM-B-0043" ;
    cm:pack pack-base:pack ;
    cm:statement "Tiered pricing, not-to-exceed, minimum commitment, subscription, managed service, technology-enabled service, SLA credits, performance bonuses, complexity weighting and portfolio pricing are better represented as modifiers or configurations than as independent pricing models."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:normalization" .

pack-base:CLM-B-0044 a cm:Claim ;
    skos:notation "CLM-B-0044" ;
    cm:pack pack-base:pack ;
    cm:statement "Public provider disclosures establish that specific structures exist but do not establish their prevalence."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:adversarial-qa" .

pack-base:CLM-B-0045 a cm:Claim ;
    skos:notation "CLM-B-0045" ;
    cm:pack pack-base:pack ;
    cm:statement "No single margin target can sensibly govern structures with different volume, capacity, execution and automation economics."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0046 a cm:Claim ;
    skos:notation "CLM-B-0046" ;
    cm:pack pack-base:pack ;
    cm:statement "Minimum commitments protect low-volume revenue but can degrade client value realization."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0047 a cm:Claim ;
    skos:notation "CLM-B-0047" ;
    cm:pack pack-base:pack ;
    cm:statement "Pure unit pricing exposes provider fixed-cost recovery to volume."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0048 a cm:Claim ;
    skos:notation "CLM-B-0048" ;
    cm:pack pack-base:pack ;
    cm:statement "Dedicated FTE pricing stabilizes provider economics but transfers utilization risk to the client."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0049 a cm:Claim ;
    skos:notation "CLM-B-0049" ;
    cm:pack pack-base:pack ;
    cm:statement "Fixed project fees transfer execution and overrun risk to the provider."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0050 a cm:Claim ;
    skos:notation "CLM-B-0050" ;
    cm:pack pack-base:pack ;
    cm:statement "Automation-heavy output models can create nonlinear margin expansion as fixed engineering and platform investment is leveraged over growing volume."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0051 a cm:Claim ;
    skos:notation "CLM-B-0051" ;
    cm:pack pack-base:pack ;
    cm:statement "Complexity weighting reduces adverse selection but increases measurement and governance burden."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:casebook-conclusions" .

pack-base:CLM-B-0052 a cm:Claim ;
    skos:notation "CLM-B-0052" ;
    cm:pack pack-base:pack ;
    cm:statement "Prompts and tokens may be poor proxies for client value when consumption pricing is applied to AI-enabled services."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:MECH-009" .

pack-base:realization.CL-R01 a cm:Realization ;
    rdfs:label "Minimum spend commitment"@en ;
    skos:notation "CL-R01" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-R01 ;
    cm:kind "lever" ;
    cm:riskEffects "{\"volume_shortfall\": {\"NONE_ADVERSE\": \"SHARED\", \"PROVIDER\": \"SHARED\"}}"^^rdf:JSON ;
    cm:fragment "{\"once\": {\"commitments\": [{\"accumulation_period\": \"CONTRACT_YEAR\", \"aggregation_scope\": \"ENGAGEMENT\", \"amount\": \"<required: minimum spend per contract year>\", \"id\": \"minimum_spend\", \"kind\": \"MINIMUM_SPEND\", \"shortfall_rule\": \"PERIOD_END_TRUE_UP\", \"tested_against\": \"GROSS\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-R06 a cm:Realization ;
    rdfs:label "Rollover of unused allowance"@en ;
    skos:notation "CL-R06" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-R06 ;
    cm:kind "lever" ;
    cm:riskEffects "{\"volume_shortfall\": {\"CLIENT\": \"SHARED\"}}"^^rdf:JSON ;
    cm:fragment "{\"patch\": {\"entitlements\": {\"rollover\": {\"policy\": \"NEXT_PERIOD\"}}}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-R09 a cm:Realization ;
    rdfs:label "Setup or onboarding fee"@en ;
    skos:notation "CL-R09" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-R09 ;
    cm:kind "lever" ;
    cm:riskEffects "{\"early_exit\": {\"PROVIDER\": \"SHARED\"}}"^^rdf:JSON ;
    cm:fragment "{\"once\": {\"components\": [{\"billing_basis\": \"FIXED\", \"calculation_method\": \"FIXED_RECURRING\", \"charge_cadence\": \"ONE_TIME\", \"fixed_amount\": \"<required: setup fee>\", \"id\": \"setup_fee\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-V04 a cm:Realization ;
    rdfs:label "Volume discount above a threshold"@en ;
    skos:notation "CL-V04" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-V04 ;
    cm:kind "lever" ;
    cm:fragment "{\"once\": {\"adjustments\": [{\"accumulation_period\": \"CONTRACT_YEAR\", \"applies_to\": \"{variable_ids}\", \"id\": \"volume_discount\", \"percent\": \"<required: discount on spend above the threshold, as a fraction>\", \"threshold\": \"<required: spend threshold per contract year>\", \"threshold_scope\": \"EXCESS_ONLY\", \"type\": \"DISCOUNT\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-V05 a cm:Realization ;
    rdfs:label "Volume rebate"@en ;
    skos:notation "CL-V05" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-V05 ;
    cm:kind "lever" ;
    cm:fragment "{\"once\": {\"adjustments\": [{\"accumulation_period\": \"CONTRACT_YEAR\", \"applies_to\": \"{variable_ids}\", \"id\": \"volume_rebate\", \"percent\": \"<required: rebate on the year's spend, as a fraction>\", \"threshold\": \"<required: spend threshold per contract year>\", \"threshold_scope\": \"ENTIRE_SUBTOTAL\", \"type\": \"REBATE\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-V07 a cm:Realization ;
    rdfs:label "Annual fee cap"@en ;
    skos:notation "CL-V07" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-V07 ;
    cm:kind "lever" ;
    cm:riskEffects "{\"spend_variability\": {\"VARIABLE\": \"BOUNDED\"}, \"volume_excess\": {\"NONE_ADVERSE\": \"PROVIDER\"}}"^^rdf:JSON ;
    cm:fragment "{\"once\": {\"adjustments\": [{\"accumulation_period\": \"CONTRACT_YEAR\", \"amount\": \"<required: fee cap per contract year>\", \"applies_to\": \"{variable_ids}\", \"id\": \"fee_cap\", \"type\": \"CAP\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-V08 a cm:Realization ;
    rdfs:label "Volume collar"@en ;
    skos:notation "CL-V08" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-V08 ;
    cm:kind "lever" ;
    cm:riskEffects "{\"volume_excess\": {\"NONE_ADVERSE\": \"SHARED\"}, \"volume_shortfall\": {\"NONE_ADVERSE\": \"SHARED\", \"PROVIDER\": \"SHARED\"}}"^^rdf:JSON ;
    cm:fragment "{\"per_variable\": {\"adjustments\": [{\"component_id\": \"{c}\", \"id\": \"collar_{c}\", \"lower\": \"<required: lower volume bound per month{c_t}>\", \"outside_rate_schedule_id\": \"outside_rate_{c}\", \"type\": \"COLLAR\", \"upper\": \"<required: upper volume bound per month{c_t}>\"}], \"rate_schedules\": [{\"id\": \"outside_rate_{c}\", \"tiers\": [{\"from\": \"0\", \"rate\": \"<required: unit rate outside the volume band{c_t}>\", \"to\": null}], \"unit\": \"{c_unit}\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-P01 a cm:Realization ;
    rdfs:label "Service-level credit"@en ;
    skos:notation "CL-P01" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-P01 ;
    cm:kind "lever" ;
    cm:fragment "{\"once\": {\"adjustments\": [{\"cap_percent\": \"<required: maximum credit in a month, as a fraction of the month's fees>\", \"id\": \"service_credit\", \"percent\": \"<required: credit when the service level is missed, as a fraction of the month's fees>\", \"trigger\": \"scenario.sla_missed\", \"type\": \"SLA_CREDIT\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-P02 a cm:Realization ;
    rdfs:label "Performance bonus"@en ;
    skos:notation "CL-P02" ;
    cm:pack pack-base:pack ;
    cm:realizes pack-base:CL-P02 ;
    cm:kind "lever" ;
    cm:fragment "{\"once\": {\"adjustments\": [{\"cap_percent\": \"<required: maximum bonus in a month, as a fraction of the month's fees>\", \"id\": \"performance_bonus\", \"percent\": \"<required: bonus when the target is met, as a fraction of the month's fees>\", \"trigger\": \"scenario.target_met\", \"type\": \"BONUS\"}]}}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:sourceRef "cometric:design" .

pack-base:realization.CL-P12 a cm:Realization ;
