    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": null, \"limitation\": \"Highly assumption-sensitive in professional services.\", \"requires\": null, \"unit_period\": \"currency\"}"^^rdf:JSON .

pack-base:FM-035 a skos:Concept ;
    skos:notation "FM-035" ;
    skos:prefLabel "Renewal contribution value"@en ;
    skos:definition "Expected contribution from renewal multiplied by its probability, less renewal cost."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-035" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": \"E[RenewalContribution] * P(renewal) - RenewalCost\", \"limitation\": \"Probability generally requires internal data.\", \"requires\": null, \"unit_period\": \"currency\"}"^^rdf:JSON .

pack-base:CHI-001 a skos:Concept ;
    skos:notation "CHI-001" ;
    skos:prefLabel "Commitment utilization ratio"@en ;
    skos:definition "A low value signals possible under-consumption. Computed as Consumed eligible value / committed eligible value."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
