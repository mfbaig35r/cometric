    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0002 ;
    cm:sourceRef "report:billing-bases" ;
    cm:status "active" ;
    cm:attributes "{\"cadence_note\": \"any cadence\", \"calculation\": \"Fee = Time * Rate\", \"core_basis\": \"TIME\", \"economic_object\": \"Professional effort\", \"row\": 1}"^^rdf:JSON .

pack-base:BB-RESOURCE a skos:Concept ;
    skos:notation "BB-RESOURCE" ;
    skos:prefLabel "Resource"@en ;
    skos:definition "Billing basis whose economic object purchased is: named or qualified people or fte capacity. Fundamental calculation: Fee = Resources * ResourceRate * Period."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
    skos:related pack-base:PM-004, pack-base:PM-005 ;
    cm:billingBasis cmv:BillingBasis.RESOURCE ;
