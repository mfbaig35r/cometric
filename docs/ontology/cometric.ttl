    cm:status "active" ;
    cm:attributes "{\"cadence_note\": \"any cadence\", \"calculation\": \"Fee = Sum(Units_i * UnitRate_i)\", \"core_basis\": \"OUTPUT\", \"economic_object\": \"Completed units\", \"row\": 4}"^^rdf:JSON .

pack-base:BB-USAGE a skos:Concept ;
    skos:notation "BB-USAGE" ;
    skos:prefLabel "Usage"@en ;
    skos:definition "Billing basis whose economic object purchased is: metered technology or service consumption. Fundamental calculation: Fee = Sum(Usage_i * MeterRate_i)."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
    skos:related pack-base:PM-013, pack-base:PM-030, pack-base:PM-034 ;
