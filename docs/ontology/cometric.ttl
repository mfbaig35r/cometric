pack-alsp:CLM-A-0024 a cm:Claim ;
    skos:notation "CLM-A-0024" ;
    cm:pack pack-alsp:pack ;
    cm:statement "A corporate legal-department association handbook documents fixed fees, collars, success fees, value-based billing and performance holdbacks."@en ;
