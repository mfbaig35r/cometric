pack-alsp:CLM-A-0044 a cm:Claim ;
    skos:notation "CLM-A-0044" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Legal-sector providers document fixed recurring managed-service fees."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E009, pack-alsp:E015 ;
