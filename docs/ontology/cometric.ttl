pack-alsp:CLM-A-0046 a cm:Claim ;
    skos:notation "CLM-A-0046" ;
    cm:pack pack-alsp:pack ;
    cm:statement "AI pricing in legal services is evolving quickly; current examples include separate technology fees, fixed AI-enabled outcomes and consumption alternatives, without a converged standard architecture."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.EMERGING ;
    cm:source pack-alsp:E008, pack-alsp:E037 ;
    cm:sourceRef "report:research-gaps" .

pack-alsp:CLM-A-0047 a cm:Claim ;
    skos:notation "CLM-A-0047" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Provider status is economically and ontologically material: a staffing provider, regulated law firm, law-firm affiliate and technology vendor may face different permissible scopes and compensation structures."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E007 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:CLM-A-0048 a cm:Claim ;
    skos:notation "CLM-A-0048" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
