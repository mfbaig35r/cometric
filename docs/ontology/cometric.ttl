pack-base:FM-034 a skos:Concept ;
    skos:notation "FM-034" ;
    skos:prefLabel "Customer lifetime value (CLV)"@en ;
    skos:definition "Discounted expected future contribution less acquisition and retention cost."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
