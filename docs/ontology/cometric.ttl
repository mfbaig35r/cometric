pack-base:CHI-011 a skos:Concept ;
    skos:notation "CHI-011" ;
    skos:prefLabel "Capacity-service mismatch"@en ;
    skos:definition "Highlights structural overcapacity. Computed as Reserved capacity - actual or forecast demand."@en ;
