pack-alsp:CLM-A-0023 a cm:Claim ;
    skos:notation "CLM-A-0023" ;
    cm:pack pack-alsp:pack ;
    cm:statement "At least one legal-services provider offers a fixed fee for responsive-document coding within an AI-enabled review offering that still involves attorneys and expert workflow management."@en ;
