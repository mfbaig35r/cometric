    cm:sourceRef "report:billing-bases" ;
    cm:status "active" ;
    cm:attributes "{\"cadence_note\": \"any cadence\", \"calculation\": \"Fee = Resources * ResourceRate * Period\", \"core_basis\": \"RESOURCE\", \"economic_object\": \"Named or qualified people or FTE capacity\", \"row\": 2}"^^rdf:JSON .

pack-base:BB-CAPACITY a skos:Concept ;
    skos:notation "BB-CAPACITY" ;
    skos:prefLabel "Capacity"@en ;
    skos:definition "Billing basis whose economic object purchased is: availability or throughput reservation. Fundamental calculation: Fee = ReservedCapacity * CapacityRate."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
    skos:related pack-base:PM-009, pack-base:PM-010 ;
