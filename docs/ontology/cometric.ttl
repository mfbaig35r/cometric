pack-alsp:CLM-A-0008 a cm:Claim ;
    skos:notation "CLM-A-0008" ;
    cm:pack pack-alsp:pack ;
    cm:statement "A 2025 legal-operations survey found ALSP use expanding beyond eDiscovery into contract management and legal staffing."@en ;
