pack-base:PM-032 a skos:Concept ;
    skos:notation "PM-032" ;
    skos:prefLabel "Reverse contingency"@en ;
    skos:altLabel "reverse contingent fee"@en ;
    skos:definition "An outcome fee measured against an avoided-loss baseline, typically in defense work."@en ;
