pack-alsp:CLM-A-0025 a cm:Claim ;
    skos:notation "CLM-A-0025" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Corporate legal-department association materials document fee caps, savings sharing, retainers for continuing expertise and phase-by-phase repricing structures."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E019 ;
