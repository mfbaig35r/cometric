pack-alsp:CLM-A-0026 a cm:Claim ;
    skos:notation "CLM-A-0026" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Corporate legal-department association materials document preferred-provider practices."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E019 ;
    cm:sourceRef "report:CL-R12" .

pack-alsp:CLM-A-0027 a cm:Claim ;
    skos:notation "CLM-A-0027" ;
    cm:pack pack-alsp:pack ;
    cm:statement "US Model Rule 1.5 requires reasonable legal fees and regulates contingent fees, prohibiting them in certain domestic-relations matters and in criminal defense."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E028 ;
    cm:sourceRef "report:RULE-012" .

pack-alsp:CLM-A-0028 a cm:Claim ;
    skos:notation "CLM-A-0028" ;
    cm:pack pack-alsp:pack ;
    cm:statement "US Model Rule 5.4 generally bars lawyers and law firms from sharing legal fees with nonlawyers and restricts nonlawyer ownership and control."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E029 ;
    cm:sourceRef "report:us-constraints" .

pack-alsp:CLM-A-0029 a cm:Claim ;
    skos:notation "CLM-A-0029" ;
    cm:pack pack-alsp:pack ;
    cm:statement "State adoption of the US model rules of professional conduct varies materially, so the model rules are not uniform state law."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E028, pack-alsp:E029 ;
    cm:sourceRef "report:us-constraints" .

pack-alsp:CLM-A-0030 a cm:Claim ;
    skos:notation "CLM-A-0030" ;
    cm:pack pack-alsp:pack ;
    cm:statement "The Legal Services Act 2007 permits licensed bodies, commonly described as alternative business structures, subject to authorization rules."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E031 ;
    cm:sourceRef "report:uk-constraints" .

pack-alsp:CLM-A-0031 a cm:Claim ;
    skos:notation "CLM-A-0031" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Solicitor conduct rules in England and Wales require disclosure of relevant fee-sharing arrangements and financial interests in referrals."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E030 ;
    cm:sourceRef "report:uk-constraints" .

pack-alsp:CLM-A-0032 a cm:Claim ;
    skos:notation "CLM-A-0032" ;
    cm:pack pack-alsp:pack ;
    cm:statement "In October 2026 an eDiscovery provider explicitly contrasted per-gigabyte and per-prompt pricing with predictable outcome pricing for AI-enabled work."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.EMERGING ;
    cm:source pack-alsp:E037 ;
    cm:sourceRef "report:PM-030" .

pack-alsp:CLM-A-0033 a cm:Claim ;
    skos:notation "CLM-A-0033" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Law-firm KPI definitions describe realization as billable work that gets invoiced; other organizations use revenue or labor-value variants."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E039 ;
    cm:sourceRef "report:FM-028" .

pack-alsp:CLM-A-0034 a cm:Claim ;
    skos:notation "CLM-A-0034" ;
    cm:pack pack-alsp:pack ;
    cm:statement "2026 legal-market research documents increasing integration of ALSPs into the legal market."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E040 ;
    cm:caveat "Not found on the publicly accessible landing page. Detail is in the full report behind a registration form and was not checked on 2026-11-03."@en ;
    cm:sourceRef "report:evidence-register" .

pack-alsp:CLM-A-0035 a cm:Claim ;
    skos:notation "CLM-A-0035" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Hourly and resource pricing, fixed fees, subscriptions, per-unit charges and hybrids coexist among ALSPs."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E006, pack-alsp:E009, pack-alsp:E011, pack-alsp:E014, pack-alsp:E015, pack-alsp:E016 ;
    cm:sourceRef "report:executive-synthesis" .

pack-alsp:CLM-A-0036 a cm:Claim ;
    skos:notation "CLM-A-0036" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Public evidence does not support the proposition that ALSPs have converged on a single new pricing paradigm."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E006, pack-alsp:E009, pack-alsp:E011 ;
    cm:sourceRef "report:executive-synthesis" .

pack-alsp:CLM-A-0037 a cm:Claim ;
    skos:notation "CLM-A-0037" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Flexible-resource and eDiscovery providers disclose substantially more public pricing detail than large bespoke managed-services providers."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:methodology" .

pack-alsp:CLM-A-0038 a cm:Claim ;
    skos:notation "CLM-A-0038" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Public ALSP evidence is stronger for types of fee arrangement than for commercial details; providers rarely disclose minimum commitments, floors, collars, margin targets, overage rates, escalation formulas or risk-premium methodology."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:research-gaps" .

pack-alsp:CLM-A-0039 a cm:Claim ;
    skos:notation "CLM-A-0039" ;
    cm:pack pack-alsp:pack ;
    cm:statement "There is limited public evidence on actual ALSP gross margins or cost structures, so public pricing cannot support an external industry target margin."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:research-gaps" .

pack-alsp:CLM-A-0040 a cm:Claim ;
    skos:notation "CLM-A-0040" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Client-savings claims in ALSP case studies often do not reveal whether transition, internal governance, technology licenses, retained oversight or exit costs were included, so they cannot be converted into market benchmarks."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:research-gaps" .

pack-alsp:CLM-A-0041 a cm:Claim ;
    skos:notation "CLM-A-0041" ;
    cm:pack pack-alsp:pack ;
    cm:statement "No public longitudinal dataset was found connecting specific pricing structures to ALSP renewal rates."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:research-gaps" .

pack-alsp:CLM-A-0042 a cm:Claim ;
    skos:notation "CLM-A-0042" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Legal AI delivery commonly retains both human and technology components."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.EMERGING ;
    cm:source pack-alsp:E008, pack-alsp:E016 ;
