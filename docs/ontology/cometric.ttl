    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0021, pack-alsp:CLM-A-0022, pack-alsp:CLM-A-0008 ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" .

pack-alsp:DOCUMENT_REVIEW a skos:Concept ;
    skos:notation "DOCUMENT_REVIEW" ;
