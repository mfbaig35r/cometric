# --- pack consulting -----------------------------------------------------------------------

pack-consulting:pack a cm:Pack ;
    rdfs:label "Consulting and advisory services"@en ;
    rdfs:comment "Consulting-sector pack: service categories, unit templates, provider types, realization and staffing concepts, review rules for outcome-based fees, and engagement templates for role-based time and materials, capped time and materials, phased fixed fees, hours-drawdown retainers, and fixed fees with a success component.\n"@en ;
    owl:versionInfo "0.1.0" ;
    cm:extends pack-base:pack .

pack-consulting:scheme.consulting_concepts a skos:ConceptScheme ;
    rdfs:label "Realization, staffing, and fee concepts for consulting"@en ;
    skos:notation "consulting_concepts" ;
    cm:pack pack-consulting:pack .

pack-consulting:CONS-001 a skos:Concept ;
    skos:notation "CONS-001" ;
    skos:prefLabel "Realization"@en ;
    skos:altLabel "realization rate"@en ;
    skos:definition "Billed or contractual value divided by the value of hours worked at standard rates. Below 1 means a write-down; above 1 means a write-up.\n"@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:FM-028, pack-consulting:CONS-002, pack-consulting:CONS-005 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Definitions vary by organization; record the convention used."@en ;
    cm:sourceRef "report:FM-028" ;
    cm:attributes "{\"computed_by\": \"realization\", \"formula\": \"contractual_fee / standard_value\"}"^^rdf:JSON .

pack-consulting:CONS-002 a skos:Concept ;
    skos:notation "CONS-002" ;
    skos:prefLabel "Write-down"@en ;
    skos:definition "Standard value of hours worked minus the contractual fee for those hours."@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-consulting:CONS-001 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:FM-028" ;
    cm:attributes "{\"computed_by\": \"write_down\", \"formula\": \"standard_value - contractual_fee\"}"^^rdf:JSON .

pack-consulting:CONS-003 a skos:Concept ;
    skos:notation "CONS-003" ;
    skos:prefLabel "Effective billing rate"@en ;
    skos:definition "Contractual fee divided by hours worked. For fixed fees it is retrospective."@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:FM-023 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:FM-023" ;
    cm:attributes "{\"computed_by\": \"effective_billing_rate\", \"formula\": \"contractual_fee / worked_hours\"}"^^rdf:JSON .

pack-consulting:CONS-004 a skos:Concept ;
    skos:notation "CONS-004" ;
    skos:prefLabel "Staffing leverage"@en ;
    skos:altLabel "pyramid"@en, "seniority mix"@en ;
    skos:definition "The ratio of junior to senior effort on an engagement. It is a major direct-cost lever; a mix that is too junior can damage quality.\n"@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:CL-D04, pack-base:PM-002, pack-base:PM-003 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-D04" .

pack-consulting:CONS-005 a skos:Concept ;
    skos:notation "CONS-005" ;
    skos:prefLabel "Standard rate card"@en ;
    skos:definition "The rate per role used to value hours worked, independent of the contracted price."@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:PM-003, pack-consulting:CONS-001 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"engine_field\": \"delivery_plan.standard_rate_card\"}"^^rdf:JSON .

pack-consulting:CONS-006 a skos:Concept ;
    skos:notation "CONS-006" ;
    skos:prefLabel "Phased fixed fee"@en ;
    skos:definition "A fixed fee per phase, with each phase repriced or confirmed at its checkpoint."@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:PM-017, pack-base:PM-006 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:PM-017" .

pack-consulting:CONS-007 a skos:Concept ;
    skos:notation "CONS-007" ;
    skos:prefLabel "Hours-drawdown retainer"@en ;
    skos:definition "A periodic fee that includes a number of hours, with overage above the allowance."@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:CL-R04, pack-base:PM-008, pack-base:CL-V01, pack-base:CL-V02 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R04" .

pack-consulting:CONS-008 a skos:Concept ;
    skos:notation "CONS-008" ;
    skos:prefLabel "Success fee"@en ;
    skos:definition "A fee contingent on a defined result. It needs a measurable metric, a baseline or target, an attribution method, a cap, and approval.\n"@en ;
    skos:inScheme pack-consulting:scheme.consulting_concepts ;
    skos:related pack-base:PM-025, pack-base:PM-026, pack-base:PM-027 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0006, pack-base:CLM-B-0041 ;
    cm:sourceRef "report:PM-025" ;
    cm:attributes "{\"engine_method\": \"OUTCOME_ADJUSTMENT\"}"^^rdf:JSON .

pack-consulting:scheme.provider_types a skos:ConceptScheme ;
    rdfs:label "Consulting provider types"@en ;
    skos:notation "provider_types" ;
    cm:pack pack-consulting:pack .

pack-consulting:LARGE_ADVISORY_FIRM a skos:Concept ;
    skos:notation "LARGE_ADVISORY_FIRM" ;
    skos:prefLabel "Large advisory firm"@en ;
    skos:definition "A multi-practice firm delivering advisory, implementation, and managed services, sometimes alongside audit or assurance work."@en ;
    skos:inScheme pack-consulting:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"commercial_implications\": \"Where the firm also provides assurance to the client, independence rules may restrict contingent or outcome-based fees; review before proposing them.\"}"^^rdf:JSON .

pack-consulting:BOUTIQUE a skos:Concept ;
    skos:notation "BOUTIQUE" ;
    skos:prefLabel "Boutique"@en ;
    skos:definition "A specialist firm focused on a sector, function, or method."@en ;
    skos:inScheme pack-consulting:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"commercial_implications\": \"Smaller teams make dedicated-resource pricing and capacity commitments a material utilization risk.\"}"^^rdf:JSON .

pack-consulting:INDEPENDENT_PRACTITIONER a skos:Concept ;
    skos:notation "INDEPENDENT_PRACTITIONER" ;
    skos:prefLabel "Independent practitioner"@en ;
    skos:definition "An individual consultant or small partnership contracting directly."@en ;
    skos:inScheme pack-consulting:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"commercial_implications\": \"Retainers and capped time and materials limit exposure to concentration and idle time.\"}"^^rdf:JSON .

pack-consulting:TECHNOLOGY_INTEGRATOR a skos:Concept ;
    skos:notation "TECHNOLOGY_INTEGRATOR" ;
    skos:prefLabel "Technology integrator"@en ;
    skos:definition "A firm delivering system implementation and support, often with platform or license components."@en ;
    skos:inScheme pack-consulting:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"commercial_implications\": \"Implementation plus recurring support (PM-029) separates setup recovery from run economics.\"}"^^rdf:JSON .

pack-consulting:scheme.service_categories a skos:ConceptScheme ;
    rdfs:label "Consulting service categories"@en ;
    skos:notation "service_categories" ;
    cm:pack pack-consulting:pack .

pack-consulting:STRATEGY a skos:Concept ;
    skos:notation "STRATEGY" ;
    skos:prefLabel "Strategy"@en ;
    skos:definition "Advisory work on direction, portfolio, market, or organizational choices, usually scoped by questions rather than volumes."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:OPERATIONS_IMPROVEMENT a skos:Concept ;
    skos:notation "OPERATIONS_IMPROVEMENT" ;
    skos:prefLabel "Operations improvement"@en ;
    skos:definition "Diagnosis and redesign of processes, cost structures, or service levels, often with a measurable baseline."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:TRANSFORMATION a skos:Concept ;
    skos:notation "TRANSFORMATION" ;
    skos:prefLabel "Transformation"@en ;
    skos:definition "Multi-phase change programs combining design, implementation, and adoption, with scope that evolves between phases."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:IMPLEMENTATION a skos:Concept ;
    skos:notation "IMPLEMENTATION" ;
    skos:prefLabel "Implementation"@en ;
    skos:definition "Delivery of a defined system, process, or operating model to an acceptance point."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:ADVISORY_RETAINER a skos:Concept ;
    skos:notation "ADVISORY_RETAINER" ;
    skos:prefLabel "Advisory retainer"@en ;
    skos:definition "Ongoing access to advisers for a periodic fee, typically drawn down against included hours."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    skos:related pack-base:PM-008, pack-base:CL-R04 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:INTERIM_MANAGEMENT a skos:Concept ;
    skos:notation "INTERIM_MANAGEMENT" ;
    skos:prefLabel "Interim management"@en ;
    skos:definition "Placement of an executive or specialist into a client role for a period, priced by time or by resource."@en ;
    skos:inScheme pack-consulting:scheme.service_categories ;
    skos:related pack-base:PM-004, pack-base:PM-005 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" .

pack-consulting:scheme.unit_templates a skos:ConceptScheme ;
    rdfs:label "Consulting unit templates"@en ;
    skos:notation "unit_templates" ;
    cm:pack pack-consulting:pack .

pack-consulting:consultant_day a skos:Concept ;
    skos:notation "consultant_day" ;
    skos:prefLabel "Consultant day"@en ;
    skos:definition "One day of consultant effort."@en ;
    skos:inScheme pack-consulting:scheme.unit_templates ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"acceptance_rule_prompt\": \"Who approves timesheets, and within what period?\", \"complexity_note\": \"Day rates often differ by seniority; record a rate per role.\", \"counting_rule_prompt\": \"How many hours make a billable day, and are partial days rounded?\", \"kind\": \"HOURS\"}"^^rdf:JSON .

pack-consulting:accepted_deliverable a skos:Concept ;
    skos:notation "accepted_deliverable" ;
    skos:prefLabel "Accepted deliverable"@en ;
    skos:definition "One deliverable accepted by the client against defined acceptance criteria."@en ;
    skos:inScheme pack-consulting:scheme.unit_templates ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"acceptance_rule_prompt\": \"What are the acceptance criteria, who signs off, and what happens on silence?\", \"complexity_note\": \"Acceptance ambiguity is a common source of disputes on deliverable-based fees.\", \"counting_rule_prompt\": \"Which deliverables are in scope, and what makes each one distinct?\", \"kind\": \"COUNT\"}"^^rdf:JSON .

pack-consulting:workstream_month a skos:Concept ;
    skos:notation "workstream_month" ;
    skos:prefLabel "Workstream month"@en ;
    skos:definition "One month of an agreed workstream with a defined team and objective."@en ;
    skos:inScheme pack-consulting:scheme.unit_templates ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "pack:consulting" ;
    cm:attributes "{\"acceptance_rule_prompt\": \"What evidence closes out a workstream month?\", \"complexity_note\": \"Equivalent to a capacity reservation if the team is held for the client.\", \"counting_rule_prompt\": \"What team and scope define one workstream?\", \"kind\": \"COUNT\"}"^^rdf:JSON .

pack-consulting:overlay.PM-001 a cm:Overlay ;
    cm:overlays pack-base:PM-001 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Consulting-sector prevalence is not evidenced in the source research."@en .

pack-consulting:overlay.PM-003 a cm:Overlay ;
    cm:overlays pack-base:PM-003 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Role-based rate cards are the usual basis for valuing consulting effort; prevalence is not evidenced in the source research."@en .

pack-consulting:overlay.PM-006 a cm:Overlay ;
    cm:overlays pack-base:PM-006 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0049 ;
    cm:caveat "Fixed project fees transfer execution and overrun risk to the provider; define scope assumptions and change control."@en .

pack-consulting:overlay.PM-017 a cm:Overlay ;
    cm:overlays pack-base:PM-017 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Phase-by-phase pricing contains scope risk where early discovery is uncertain."@en .

pack-consulting:overlay.PM-020 a cm:Overlay ;
    cm:overlays pack-base:PM-020 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Consulting-sector prevalence is not evidenced in the source research."@en .

pack-consulting:overlay.PM-024 a cm:Overlay ;
    cm:overlays pack-base:PM-024 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0006, pack-base:CLM-B-0041 ;
    cm:caveat "Outcome pricing is less transferable where provider controllability is weak."@en .

pack-consulting:overlay.PM-025 a cm:Overlay ;
    cm:overlays pack-base:PM-025 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0006 .

pack-consulting:overlay.PM-026 a cm:Overlay ;
    cm:overlays pack-base:PM-026 ;
    cm:pack pack-consulting:pack ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0006, pack-base:CLM-B-0036 ;
    cm:caveat "Baseline and attribution disputes can be severe; agree both before work starts."@en .

pack-consulting:CONS-R-001 a cm:Rule ;
    skos:notation "CONS-R-001" ;
    cm:pack pack-consulting:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "CONSULTING_OUTCOME_FEE_REVIEW" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Outcome-based consideration needs review; independence and professional rules may restrict contingent fees for some advisory work, for example where the provider also gives assurance to the client."@en ;
    cm:explanation "Outcome fees need a baseline, attribution, cap, and approval, and some advisory relationships restrict contingent compensation."@en ;
    cm:condition "{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0041 ;
    cm:sourceRef "report:RULE-003" .

pack-consulting:CONS-R-002 a cm:Rule ;
    skos:notation "CONS-R-002" ;
    cm:pack pack-consulting:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "CONSULTING_UNCAPPED_TIME_ON_UNCERTAIN_SCOPE" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "Uncapped time and materials on strategy or transformation scope leaves the client with duration risk; consider a cap or a phased fixed fee."@en ;
    cm:explanation "Selection heuristic for highly uncertain scope; an inference, not a rule."@en ;
    cm:condition "{\"all\": [{\"equals\": \"TIME\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}, {\"in\": [\"STRATEGY\", \"TRANSFORMATION\"], \"path\": \"services[*].service_category\"}, {\"not\": {\"equals\": \"CAP\", \"path\": \"arrangement_versions[*].adjustments[*].type\"}}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:sourceRef "report:decision-matrix" .

pack-consulting:CONS-R-003 a cm:Rule ;
    skos:notation "CONS-R-003" ;
    cm:pack pack-consulting:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "CONSULTING_FIXED_FEE_SCOPE_CONTROL" ;
    cm:severity cmv:Severity.INFO ;
    cm:message "A fixed project fee needs scope assumptions, exclusions, and change-order triggers to bound the provider's effort risk."@en ;
    cm:explanation "Fixed project fees transfer execution and overrun risk to the provider."@en ;
    cm:condition "{\"equals\": \"FIXED_PROJECT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0049 ;
    cm:sourceRef "report:PM-006" .
