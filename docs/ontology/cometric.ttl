pack-base:BB-OUTCOME a skos:Concept ;
    skos:notation "BB-OUTCOME" ;
    skos:prefLabel "Outcome or value"@en ;
    skos:definition "Billing basis whose economic object purchased is: defined result, savings or recovery. Fundamental calculation: Formula linked to outcome."@en ;
