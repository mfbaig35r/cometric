    cm:sourceRef "report:CHI-001" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"commitment_utilization\", \"family\": \"commercial_health\", \"formula\": \"Consumed eligible value / committed eligible value\", \"interpretation\": \"A low value signals possible under-consumption.\", \"limitation\": \"Does not value availability.\", \"requires\": null, \"unit_period\": null}"^^rdf:JSON .

pack-base:CHI-002 a skos:Concept ;
    skos:notation "CHI-002" ;
    skos:prefLabel "Effective client cost per unit"@en ;
    skos:definition "A rising value may indicate poor economics. Computed as Total client fee / completed normalized units."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
