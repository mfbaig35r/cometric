@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cm: <https://github.com/mfbaig35r/cometric/ontology/core#> .
@prefix cmv: <https://github.com/mfbaig35r/cometric/ontology/vocab#> .
@prefix pack-alsp: <https://github.com/mfbaig35r/cometric/ontology/pack/alsp#> .
@prefix pack-base: <https://github.com/mfbaig35r/cometric/ontology/pack/base#> .
@prefix pack-consulting: <https://github.com/mfbaig35r/cometric/ontology/pack/consulting#> .

<https://github.com/mfbaig35r/cometric/ontology/> a owl:Ontology ;
    rdfs:label "Cometric commercial ontology"@en ;
    rdfs:comment "Commercial arrangements, engagement economics, and domain knowledge: OWL classes for the input model, SKOS concept schemes for the core vocabularies and every pack, and the rules and evidence the packs carry. Generated from the cometric package."@en ;
    owl:versionInfo "schema 0.2; packs alsp 0.1.0, base 0.2.0, consulting 0.1.0" ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .

# --- ontology terms ------------------------------------------------------------------------

cm:Pack a owl:Class ;
    rdfs:label "pack"@en ;
    rdfs:comment "A versioned bundle of domain vocabulary, rules, evidence, and templates."@en .

cm:Overlay a owl:Class ;
    rdfs:label "overlay"@en ;
    rdfs:comment "A pack's sector-specific prevalence, evidence, or caveats for a concept defined by a pack it extends."@en .

cm:Rule a owl:Class ;
    rdfs:label "rule"@en ;
    rdfs:comment "A compatibility or reasoning rule. Evaluable rules fire on engagements whose data matches their condition."@en .

cm:Claim a owl:Class ;
    rdfs:label "claim"@en ;
    rdfs:comment "An atomic proposition with an evidence class and prevalence."@en .

cm:Source a owl:Class ;
    rdfs:label "source"@en ;
    rdfs:comment "An external source that supports claims."@en .

cm:Realization a owl:Class ;
    rdfs:label "realization"@en ;
    rdfs:comment "How a pricing model or lever becomes engagement terms, with the risk labels or label effects that structure proposals use."@en .

cm:realizes a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:comment "The pricing model or lever a realization turns into engagement terms."@en .

cm:riskLabels a owl:DatatypeProperty ;
    rdfs:label "risk labels"@en ;
    rdfs:comment "Who absorbs each deviation under a model, as a JSON object."@en .

cm:riskEffects a owl:DatatypeProperty ;
    rdfs:label "risk effects"@en ;
    rdfs:comment "How a lever changes a model's risk labels, as a JSON object of from-to maps."@en .

cm:fragment a owl:DatatypeProperty ;
    rdfs:label "fragment"@en ;
    rdfs:comment "The engagement terms a realization adds, with placeholders for every figure, as JSON."@en .

cm:pack a owl:ObjectProperty ;
    rdfs:label "pack"@en ;
    rdfs:comment "The pack that defines this concept scheme, overlay, rule, claim, or source."@en .

cm:extends a owl:ObjectProperty ;
    rdfs:label "extends"@en ;
    rdfs:comment "The pack this pack builds on."@en .

cm:overlays a owl:ObjectProperty ;
    rdfs:label "overlays"@en ;
    rdfs:comment "The concept an overlay qualifies."@en .

cm:evidenceClass a owl:ObjectProperty ;
    rdfs:label "evidence class"@en ;
    rdfs:comment "A_DIRECT, B_CORROBORATED, C_INFERENCE, or D_PROPOSED. Independent of prevalence."@en .

cm:prevalence a owl:ObjectProperty ;
    rdfs:label "prevalence"@en .

cm:billingBasis a owl:ObjectProperty ;
    rdfs:label "billing basis"@en ;
    rdfs:comment "Core billing bases a concept maps to."@en .

cm:calculationMethod a owl:ObjectProperty ;
    rdfs:label "calculation method"@en ;
    rdfs:comment "Core calculation methods that execute a concept."@en .

cm:claim a owl:ObjectProperty ;
    rdfs:label "claim"@en ;
    rdfs:comment "A claim that supports this concept, overlay, or rule."@en .

cm:source a owl:ObjectProperty ;
    rdfs:label "source"@en ;
    rdfs:comment "A source that supports this claim."@en .

cm:severity a owl:ObjectProperty ;
    rdfs:label "severity"@en .

cm:caveat a owl:AnnotationProperty ;
    rdfs:label "caveat"@en .

cm:sourceRef a owl:AnnotationProperty ;
    rdfs:label "source reference"@en ;
    rdfs:comment "Where in the originating research this entry comes from."@en .

cm:status a owl:DatatypeProperty ;
    rdfs:label "status"@en .

cm:kind a owl:DatatypeProperty ;
    rdfs:label "kind"@en .

cm:attributes a owl:DatatypeProperty ;
    rdfs:label "attributes"@en ;
    rdfs:comment "Scheme-specific attributes as a JSON object."@en .

cm:assessment a owl:DatatypeProperty ;
    rdfs:label "assessment"@en .

cm:evaluable a owl:DatatypeProperty ;
    rdfs:label "evaluable"@en ;
    rdfs:comment "Whether the engine evaluates the rule's condition against engagements."@en .

cm:code a owl:DatatypeProperty ;
    rdfs:label "issue code"@en .

cm:message a owl:DatatypeProperty ;
    rdfs:label "message"@en .

cm:explanation a owl:DatatypeProperty ;
    rdfs:label "explanation"@en .

cm:condition a owl:DatatypeProperty ;
    rdfs:label "condition"@en ;
    rdfs:comment "The rule's predicate over the engagement document, as JSON."@en .

cm:statement a owl:DatatypeProperty ;
    rdfs:label "statement"@en .

cm:url a owl:DatatypeProperty ;
    rdfs:label "URL"@en .

cm:sourceType a owl:DatatypeProperty ;
    rdfs:label "source type"@en .

cm:retrievedDate a owl:DatatypeProperty ;
    rdfs:label "retrieved date"@en .

cm:publicationDate a owl:DatatypeProperty ;
    rdfs:label "publication date"@en .

cm:verified a owl:DatatypeProperty ;
    rdfs:label "verified"@en .

cm:required a owl:AnnotationProperty ;
    rdfs:label "required"@en ;
    rdfs:comment "Whether an input document must supply this field."@en .

cm:multiple a owl:AnnotationProperty ;
    rdfs:label "multiple"@en ;
    rdfs:comment "Whether the field holds a list."@en .

cm:minItems a owl:AnnotationProperty ;
    rdfs:label "minimum items"@en .

cm:defaultValue a owl:AnnotationProperty ;
    rdfs:label "default value"@en .

cm:allowedValue a owl:AnnotationProperty ;
    rdfs:label "allowed value"@en .

cm:fieldName a owl:AnnotationProperty ;
    rdfs:label "field name"@en ;
    rdfs:comment "The JSON key of this field in input documents."@en .

cm:referencedById a owl:AnnotationProperty ;
    rdfs:label "referenced by id"@en ;
    rdfs:comment "In input documents the field holds the id of the related object."@en .

# --- core vocabularies ---------------------------------------------------------------------

cmv:AccumulationPeriod a owl:Class, skos:ConceptScheme ;
    rdfs:label "AccumulationPeriod"@en ;
    skos:definition "The period over which an allowance, minimum, tier counter, or capacity limit accumulates: MONTH, QUARTER, YEAR, CONTRACT_YEAR, TERM."@en .

cmv:AccumulationPeriod.MONTH a skos:Concept, cmv:AccumulationPeriod ;
    skos:prefLabel "MONTH"@en ;
    skos:notation "MONTH" ;
    skos:inScheme cmv:AccumulationPeriod ;
    skos:topConceptOf cmv:AccumulationPeriod .

cmv:AccumulationPeriod.QUARTER a skos:Concept, cmv:AccumulationPeriod ;
    skos:prefLabel "QUARTER"@en ;
    skos:notation "QUARTER" ;
