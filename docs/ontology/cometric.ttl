pack-base:scheme.levers a skos:ConceptScheme ;
    rdfs:label "Commercial lever catalog"@en ;
    skos:notation "levers" ;
    cm:pack pack-base:pack .

pack-base:CL-R01 a skos:Concept ;
    skos:notation "CL-R01" ;
    skos:prefLabel "Minimum spend commitment"@en ;
    skos:definition "Client guarantees periodic spend."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-034, pack-base:CL-R02, pack-base:MECH-001 ;
    cm:kind "modifier" ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0008, pack-base:CLM-B-0010, pack-base:CLM-B-0046 ;
    cm:sourceRef "report:CL-R01" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Revenue floor; client underutilization or value risk. Works with unit, usage or catalog pricing.\", \"normalization\": \"Minimum commitment modifies revenue and volume exposure.\", \"purpose\": \"Client guarantees periodic spend.\"}"^^rdf:JSON .

pack-base:CL-R02 a skos:Concept ;
    skos:notation "CL-R02" ;
    skos:prefLabel "Take-or-pay"@en ;
    skos:definition "Payment is due for the committed entitlement whether used or not."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:CL-R01, pack-base:PM-034 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Evidence is from adjacent sectors."@en ;
    cm:sourceRef "report:CL-R02" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Strong provider protection; highest client under-consumption exposure.\", \"purpose\": \"Payment is due for the committed entitlement whether used or not.\"}"^^rdf:JSON .

pack-base:CL-R03 a skos:Concept ;
    skos:notation "CL-R03" ;
    skos:prefLabel "Reserved capacity"@en ;
    skos:definition "Provider holds defined capacity for the client."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-009, pack-base:MECH-002 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0010 ;
    cm:sourceRef "report:CL-R03" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Converts idle-capacity risk partly to the client; capacity must genuinely be available.\", \"purpose\": \"Provider holds defined capacity for the client.\"}"^^rdf:JSON .

pack-base:CL-R04 a skos:Concept ;
    skos:notation "CL-R04" ;
    skos:prefLabel "Retainer drawdown"@en ;
    skos:definition "A periodic fee is consumed against services."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-008 ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R04" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Gives predictable revenue with usage visibility.\", \"purpose\": \"A periodic fee is consumed against services.\"}"^^rdf:JSON .

pack-base:CL-R05 a skos:Concept ;
    skos:notation "CL-R05" ;
    skos:prefLabel "Prepaid credits"@en ;
    skos:definition "Client buys service credits in advance."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-031, pack-base:CL-VL03 ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:sourceRef "report:CL-R05" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Cash-flow advantage; requires credit valuation and expiry rules.\", \"purpose\": \"Client buys service credits in advance.\"}"^^rdf:JSON .

pack-base:CL-R06 a skos:Concept ;
    skos:notation "CL-R06" ;
    skos:prefLabel "Rollover"@en ;
    skos:definition "Unused entitlement moves forward to a later period."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:CL-R07 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:caveat "Classified C as a design for the legal-services sector; the report notes rollover is common in adjacent subscriptions."@en ;
    cm:sourceRef "report:CL-R06" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Improves fairness but creates future delivery liability and capacity bunching.\", \"purpose\": \"Unused entitlement moves forward to a later period.\"}"^^rdf:JSON .

pack-base:CL-R07 a skos:Concept ;
    skos:notation "CL-R07" ;
    skos:prefLabel "Use-it-or-lose-it"@en ;
    skos:definition "Unused entitlement expires at the end of its period."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:CL-R06 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R07" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Protects provider economics; increases client perceived-waste risk.\", \"purpose\": \"Unused entitlement expires at the end of its period.\"}"^^rdf:JSON .

pack-base:CL-R08 a skos:Concept ;
    skos:notation "CL-R08" ;
    skos:prefLabel "Multi-year commitment"@en ;
    skos:definition "A longer term is given in exchange for price or investment consideration."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:MECH-010, pack-base:CL-P14 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0005 ;
    cm:sourceRef "report:CL-R08" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Supports transition and automation recovery; increases termination and forecast risk.\", \"purpose\": \"A longer term is given in exchange for price or investment consideration.\"}"^^rdf:JSON .

pack-base:CL-R09 a skos:Concept ;
    skos:notation "CL-R09" ;
    skos:prefLabel "Setup or onboarding fee"@en ;
    skos:definition "Recovers transition cost separately from the run-rate fee."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-029 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R09" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Prevents the run-rate fee from absorbing one-time economics.\", \"purpose\": \"Recovers transition cost separately from the run-rate fee.\"}"^^rdf:JSON .

pack-base:CL-R10 a skos:Concept ;
    skos:notation "CL-R10" ;
    skos:prefLabel "Base fee plus variable charge"@en ;
    skos:definition "A fixed readiness fee plus an activity fee."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-023, pack-base:CL-V01, pack-base:CL-V02 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0008 ;
    cm:sourceRef "report:CL-R10" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Balances predictable revenue with demand sharing.\", \"purpose\": \"A fixed readiness fee plus an activity fee.\"}"^^rdf:JSON .

pack-base:CL-R11 a skos:Concept ;
    skos:notation "CL-R11" ;
    skos:prefLabel "Minimum invoice"@en ;
    skos:definition "An administrative or revenue floor per billing period."@en ;
    skos:inScheme pack-base:scheme.levers ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R11" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Useful for low-volume support; can produce poor client unit economics at tiny volumes.\", \"purpose\": \"An administrative or revenue floor per billing period.\"}"^^rdf:JSON .

pack-base:CL-R12 a skos:Concept ;
    skos:notation "CL-R12" ;
    skos:prefLabel "Exclusivity or preferred-provider commitment"@en ;
    skos:definition "Consolidates addressable volume with one provider."@en ;
    skos:inScheme pack-base:scheme.levers ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-R12" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"REVENUE_COMMITMENT\", \"economic_effect\": \"Supports better utilization and pricing; reduces client supplier flexibility.\", \"purpose\": \"Consolidates addressable volume with one provider.\"}"^^rdf:JSON .

pack-base:CL-V01 a skos:Concept ;
    skos:notation "CL-V01" ;
    skos:prefLabel "Included allowance"@en ;
    skos:definition "The base fee includes a defined volume."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:CL-V02, pack-base:PM-023 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "report:CL-V01" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"VOLUME\", \"economic_effect\": \"Creates a clear entitlement and overage boundary.\", \"purpose\": \"The base fee includes a defined volume.\"}"^^rdf:JSON .

pack-base:CL-V02 a skos:Concept ;
    skos:notation "CL-V02" ;
    skos:prefLabel "Overage"@en ;
    skos:definition "An extra fee applies above the included volume."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:CL-V01, pack-base:PM-023, pack-base:MECH-008 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0008 ;
    cm:sourceRef "report:CL-V02" ;
    cm:status "active" ;
    cm:attributes "{\"category\": \"VOLUME\", \"economic_effect\": \"Protects the provider from high-volume downside.\", \"purpose\": \"An extra fee applies above the included volume.\"}"^^rdf:JSON .

pack-base:CL-V03 a skos:Concept ;
    skos:notation "CL-V03" ;
    skos:prefLabel "Tiered rate"@en ;
    skos:definition "A marginal or all-units rate changes by volume."@en ;
    skos:inScheme pack-base:scheme.levers ;
    skos:related pack-base:PM-014, pack-base:CL-V04 ;
