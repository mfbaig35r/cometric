    skos:inScheme pack-alsp:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0021, pack-alsp:CLM-A-0023 ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" .

pack-alsp:LEGAL_OPERATIONS a skos:Concept ;
    skos:notation "LEGAL_OPERATIONS" ;
    skos:prefLabel "Legal operations"@en ;
    skos:definition "Ongoing legal-operations support and processing teams for legal departments."@en ;
    skos:inScheme pack-alsp:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0004, pack-alsp:CLM-A-0017 ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" .

pack-alsp:REGULATORY_CHANGE a skos:Concept ;
    skos:notation "REGULATORY_CHANGE" ;
    skos:prefLabel "Regulatory change"@en ;
    skos:definition "Regulatory and business-change projects delivered as managed legal services."@en ;
    skos:inScheme pack-alsp:scheme.service_categories ;
