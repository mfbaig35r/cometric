pack-alsp:CLM-A-0002 a cm:Claim ;
    skos:notation "CLM-A-0002" ;
    cm:pack pack-alsp:pack ;
    cm:statement "The same research estimated an 18% compound annual growth rate for the ALSP market from 2021 to 2023."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:source pack-alsp:E002, pack-alsp:E001 ;
