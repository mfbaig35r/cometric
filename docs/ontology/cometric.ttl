    cm:fragment "{\"per_unit\": {\"components\": [{\"billing_basis\": \"OUTPUT\", \"calculation_method\": \"UNIT_OUTPUT\", \"charge_cadence\": \"USAGE_TRIGGERED\", \"id\": \"price_{u}\", \"quantity_source\": \"scenario.{q}\", \"rate_schedule_id\": \"rate_{u}\", \"unit\": \"{u}\"}], \"rate_schedules\": [{\"accumulation_period\": \"CONTRACT_YEAR\", \"id\": \"rate_{u}\", \"tiers\": [{\"from\": \"0\", \"rate\": \"<required: unit rate below the band boundary{t}>\", \"to\": \"<required: volume band boundary per contract year{t}>\"}, {\"from\": \"<required: volume band boundary per contract year{t}>\", \"rate\": \"<required: unit rate above the band boundary{t}>\", \"to\": null}], \"unit\": \"{u}\"}]}}"^^rdf:JSON ;
