pack-alsp:CLM-A-0043 a cm:Claim ;
    skos:notation "CLM-A-0043" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Legal-sector providers publish fixed-fee project examples."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E010, pack-alsp:E016 ;
