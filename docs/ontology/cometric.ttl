# --- pack alsp -----------------------------------------------------------------------------

pack-alsp:pack a cm:Pack ;
    rdfs:label "Alternative legal services"@en ;
    rdfs:comment "Legal-services sector pack: service categories, unit templates, provider types, regulatory constraint rules, legal-sector prevalence overlays and evidence."@en ;
    owl:versionInfo "0.1.0" ;
    cm:extends pack-base:pack .

pack-alsp:scheme.counting_rules a skos:ConceptScheme ;
    rdfs:label "Counting rules for billable legal work units"@en ;
    skos:notation "counting_rules" ;
    cm:pack pack-alsp:pack .

pack-alsp:CNT-001 a skos:Concept ;
    skos:notation "CNT-001" ;
    skos:prefLabel "Re-issued documents counted once"@en ;
    skos:altLabel "re-submissions"@en, "duplicate submissions"@en ;
    skos:definition "A document sent for review again (a re-issue or re-submission) is billed only the first time. Billable units are submitted units less the re-issued share.\n"@en ;
    skos:inScheme pack-alsp:scheme.counting_rules ;
    skos:related pack-alsp:reviewed_document, pack-alsp:accepted_contract_review ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Whether a materially changed re-issue counts as new work is a contract question; record the rule in the unit's counting_rule."@en ;
    cm:sourceRef "pack:alsp" ;
    cm:attributes "{\"modelling\": \"Declare the re-issue rate as a RATE assumption (unit ratio) and a derived quantity billable = submitted x (1 - reissue_rate). Search the rate with a parameter that sets the assumption.\\n\", \"pattern\": \"pattern_counting_rules\"}"^^rdf:JSON .

pack-alsp:CNT-002 a skos:Concept ;
    skos:notation "CNT-002" ;
    skos:prefLabel "Bundles billed once at their highest tier"@en ;
    skos:altLabel "document families"@en, "packets billed as one"@en ;
    skos:definition "A bundle of related documents is billed as one unit at the tier of its most complex document, instead of document by document.\n"@en ;
    skos:inScheme pack-alsp:scheme.counting_rules ;
    skos:related pack-alsp:reviewed_document, pack-alsp:matter ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Monthly totals cannot show which documents arrive together. The share of documents in bundles and the documents per bundle are assumptions; label their origin and test their sensitivity."@en ;
    cm:sourceRef "pack:alsp" ;
    cm:attributes "{\"modelling\": \"Declare the bundled share of lower-tier documents and documents per bundle as RATE assumptions. Derive bundled = unique x share for each lower tier, subtract it from that tier, and add bundles = (sum of bundled) / documents_per_bundle to the highest tier.\\n\", \"pattern\": \"pattern_counting_rules\"}"^^rdf:JSON .

pack-alsp:CNT-003 a skos:Concept ;
    skos:notation "CNT-003" ;
    skos:prefLabel "Work handed back part-way"@en ;
    skos:altLabel "partial completion"@en, "returned work"@en ;
    skos:definition "Work the client withdraws part-way is billed as its own unit at an agreed fraction of the full rate, or not at all.\n"@en ;
    skos:inScheme pack-alsp:scheme.counting_rules ;
    skos:related pack-alsp:accepted_contract_review ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "The fraction, and whether it depends on how far the work progressed, is contract-specific."@en ;
    cm:sourceRef "pack:alsp" ;
    cm:attributes "{\"modelling\": \"A separate unit and component priced at the agreed fraction; see pattern_partial_and_hours.\", \"pattern\": \"pattern_partial_and_hours\"}"^^rdf:JSON .

pack-alsp:scheme.provider_types a skos:ConceptScheme ;
    rdfs:label "Legal-services provider types"@en ;
    skos:notation "provider_types" ;
    cm:pack pack-alsp:pack .

pack-alsp:REGULATED_LAW_FIRM a skos:Concept ;
    skos:notation "REGULATED_LAW_FIRM" ;
    skos:prefLabel "Regulated law firm"@en ;
    skos:definition "Provider type: regulated law firm. Contingent and outcome fees require legal review."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0027, pack-alsp:CLM-A-0028, pack-alsp:CLM-A-0029, pack-alsp:CLM-A-0031, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"Contingent and outcome fees require legal review.\", \"england_wales\": \"Regulator requirements for solicitors and other regulated lawyers.\", \"us\": \"State ethics rules; fee reasonableness; nonlawyer fee-sharing restrictions often applicable.\"}"^^rdf:JSON .

pack-alsp:LICENSED_BODY a skos:Concept ;
    skos:notation "LICENSED_BODY" ;
    skos:prefLabel "Licensed body (alternative business structure)"@en ;
    skos:definition "Provider type: licensed body (alternative business structure). Broader ownership architecture, but regulated legal duties remain."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0030, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"Broader ownership architecture, but regulated legal duties remain.\", \"england_wales\": \"Express statutory framework exists under the Legal Services Act 2007.\", \"us\": \"Available only in certain jurisdictions and structures.\"}"^^rdf:JSON .

pack-alsp:NONLAW_ALSP a skos:Concept ;
    skos:notation "NONLAW_ALSP" ;
    skos:prefLabel "Non-law-firm ALSP"@en ;
    skos:definition "Provider type: non-law-firm alsp. Outcome fees tied to legal representation may be constrained."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0047, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"Outcome fees tied to legal representation may be constrained.\", \"england_wales\": \"Scope depends on reserved or nonreserved activity and authorization.\", \"us\": \"Must avoid unauthorized practice; lawyer supervision may be relevant.\"}"^^rdf:JSON .

pack-alsp:FLEXIBLE_TALENT a skos:Concept ;
    skos:notation "FLEXIBLE_TALENT" ;
    skos:prefLabel "Flexible talent provider"@en ;
    skos:definition "Provider type: flexible talent provider. Resource and FTE pricing is straightforward; supervision allocation is critical."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0013, pack-alsp:CLM-A-0009, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"Resource and FTE pricing is straightforward; supervision allocation is critical.\", \"england_wales\": \"Structure-specific.\", \"us\": \"Often provides talent rather than law-firm representation.\"}"^^rdf:JSON .

pack-alsp:LEGAL_TECH_VENDOR a skos:Concept ;
    skos:notation "LEGAL_TECH_VENDOR" ;
    skos:prefLabel "Legal technology vendor"@en ;
    skos:definition "Provider type: legal technology vendor. Usage and subscription models are generally easier, but data and AI regulation applies."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0047, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"Usage and subscription models are generally easier, but data and AI regulation applies.\", \"england_wales\": \"Same distinction as in the US.\", \"us\": \"Technology rather than legal representation.\"}"^^rdf:JSON .

pack-alsp:MANAGED_SERVICES_PROVIDER a skos:Concept ;
    skos:notation "MANAGED_SERVICES_PROVIDER" ;
    skos:prefLabel "Legal managed-services provider"@en ;
    skos:definition "Provider type: legal managed-services provider. The contract may require separation of legal advice from processing and operations."@en ;
    skos:inScheme pack-alsp:scheme.provider_types ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-alsp:CLM-A-0047, pack-alsp:CLM-A-0015, pack-alsp:CLM-A-0048 ;
    cm:caveat "Legal-counsel review is required before treating any contingent, success-based, fee-sharing, regulated-work or cross-border outsourcing structure as permissible."@en ;
    cm:sourceRef "report:provider-type-matrix" ;
    cm:status "active" ;
    cm:attributes "{\"commercial_implications\": \"The contract may require separation of legal advice from processing and operations.\", \"england_wales\": \"Provider entity and work type matter.\", \"us\": \"May combine regulated and nonregulated functions.\"}"^^rdf:JSON .

pack-alsp:scheme.service_categories a skos:ConceptScheme ;
    rdfs:label "Legal-services service categories"@en ;
    skos:notation "service_categories" ;
    cm:pack pack-alsp:pack .

pack-alsp:CONTRACTS a skos:Concept ;
    skos:notation "CONTRACTS" ;
    skos:prefLabel "Contracts"@en ;
    skos:definition "Contract review, abstraction and contracting managed services, including high-volume agreement processing."@en ;
    skos:inScheme pack-alsp:scheme.service_categories ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0015, pack-alsp:CLM-A-0018, pack-alsp:CLM-A-0008 ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" .

pack-alsp:EDISCOVERY a skos:Concept ;
