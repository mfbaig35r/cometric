    cm:status "active" ;
    cm:attributes "{\"cadence_note\": \"any cadence\", \"calculation\": \"Fee = ReservedCapacity * CapacityRate\", \"core_basis\": \"CAPACITY\", \"economic_object\": \"Availability or throughput reservation\", \"row\": 3}"^^rdf:JSON .

pack-base:BB-OUTPUT a skos:Concept ;
    skos:notation "BB-OUTPUT" ;
    skos:prefLabel "Output or transaction"@en ;
    skos:definition "Billing basis whose economic object purchased is: completed units. Fundamental calculation: Fee = Sum(Units_i * UnitRate_i)."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
