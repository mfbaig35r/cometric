pack-alsp:accepted_contract_review a skos:Concept ;
    skos:notation "accepted_contract_review" ;
    skos:prefLabel "Accepted contract review"@en ;
    skos:definition "One completed review of one eligible contract, counted when accepted."@en ;
    skos:inScheme pack-alsp:scheme.unit_templates ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0018 ;
    cm:caveat "Template only: the user must supply the counting and acceptance rules."@en ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" ;
    cm:attributes "{\"acceptance_rule_prompt\": \"When is a contract review accepted: client sign-off, a deemed-acceptance period, or another event, and what rejection rights apply?\", \"complexity_note\": \"Contracts vary materially in effort; consider complexity bands with jointly defined criteria and audit rights.\", \"counting_rule_prompt\": \"What makes one contract review countable: which documents count as one contract (amendments, schedules, duplicates), and which contracts are eligible?\", \"kind\": \"COUNT\"}"^^rdf:JSON .

pack-alsp:reviewed_document a skos:Concept ;
    skos:notation "reviewed_document" ;
    skos:prefLabel "Reviewed document"@en ;
    skos:definition "One document reviewed and coded under the agreed review protocol."@en ;
    skos:inScheme pack-alsp:scheme.unit_templates ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-alsp:CLM-A-0021 ;
    cm:caveat "Template only: the user must supply the counting and acceptance rules."@en ;
    cm:sourceRef "report:landscape" ;
    cm:status "active" ;
    cm:attributes "{\"acceptance_rule_prompt\": \"When is a reviewed document accepted: after first-level review, after quality control, or after a client sampling check?\", \"complexity_note\": \"Per-document pricing is highly measurable but vulnerable to complexity heterogeneity.\", \"counting_rule_prompt\": \"What counts as one document (families, attachments, near-duplicates), and are documents removed by culling or automation counted?\", \"kind\": \"COUNT\"}"^^rdf:JSON .

pack-alsp:custodian a skos:Concept ;
    skos:notation "custodian" ;
