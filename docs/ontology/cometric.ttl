    cm:sourceRef "report:demand-uncertainty" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"risk\", \"formula\": null, \"limitation\": \"No validated definition exists.\", \"requires\": \"distributions\", \"unit_period\": null}"^^rdf:JSON .

pack-base:scheme.negotiation_exchanges a skos:ConceptScheme ;
    rdfs:label "Commercial negotiation as exchange of risk"@en ;
    skos:notation "negotiation_exchanges" ;
    cm:pack pack-base:pack .

pack-base:NEG-001 a skos:Concept ;
    skos:notation "NEG-001" ;
    skos:prefLabel "Lower unit price for minimum volume or spend"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'lower unit price' in exchange for 'minimum volume or spend'. Provider trades price for utilization certainty."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-V04, pack-base:CL-R01 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Minimum volume or spend\", \"provider_concession\": \"Lower unit price\", \"rationale\": \"Provider trades price for utilization certainty.\", \"row\": 1}"^^rdf:JSON .

pack-base:NEG-002 a skos:Concept ;
    skos:notation "NEG-002" ;
    skos:prefLabel "Lower base fee for higher overage"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'lower base fee' in exchange for 'higher overage'. Client gains a lower fixed commitment; provider recovers upside in high demand."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-R10, pack-base:CL-V02 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Higher overage\", \"provider_concession\": \"Lower base fee\", \"rationale\": \"Client gains a lower fixed commitment; provider recovers upside in high demand.\", \"row\": 2}"^^rdf:JSON .

pack-base:NEG-003 a skos:Concept ;
    skos:notation "NEG-003" ;
    skos:prefLabel "Lower implementation fee for longer term or termination recovery"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'lower implementation fee' in exchange for 'longer term or termination recovery'. Provider amortizes investment."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-R09, pack-base:CL-R08, pack-base:CL-P14 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Longer term or termination recovery\", \"provider_concession\": \"Lower implementation fee\", \"rationale\": \"Provider amortizes investment.\", \"row\": 3}"^^rdf:JSON .

pack-base:NEG-004 a skos:Concept ;
    skos:notation "NEG-004" ;
    skos:prefLabel "Stronger SLA for higher price or capacity commitment"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'stronger sla' in exchange for 'higher price or capacity commitment'. A service guarantee requires buffer capacity."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-P04, pack-base:CL-R03 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Higher price or capacity commitment\", \"provider_concession\": \"Stronger SLA\", \"rationale\": \"A service guarantee requires buffer capacity.\", \"row\": 4}"^^rdf:JSON .

pack-base:NEG-005 a skos:Concept ;
    skos:notation "NEG-005" ;
    skos:prefLabel "Productivity guarantee for automation investment recovery"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'productivity guarantee' in exchange for 'automation investment recovery'. Provider funds transformation in exchange for a return mechanism."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-P05 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Automation investment recovery\", \"provider_concession\": \"Productivity guarantee\", \"rationale\": \"Provider funds transformation in exchange for a return mechanism.\", \"row\": 5}"^^rdf:JSON .

pack-base:NEG-006 a skos:Concept ;
    skos:notation "NEG-006" ;
    skos:prefLabel "Greater rollover for narrower service-credit rights or longer term"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'greater rollover' in exchange for 'narrower service-credit rights or longer term'. Provider accepts a deferred obligation."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-R06, pack-base:CL-P01 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Narrower service-credit rights or longer term\", \"provider_concession\": \"Greater rollover\", \"rationale\": \"Provider accepts a deferred obligation.\", \"row\": 6}"^^rdf:JSON .

pack-base:NEG-007 a skos:Concept ;
    skos:notation "NEG-007" ;
    skos:prefLabel "More flexible catalog for lower volume discount"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'more flexible catalog' in exchange for 'lower volume discount'. Flexibility reduces provider forecast certainty."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-VL04, pack-base:CL-V04 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Lower volume discount\", \"provider_concession\": \"More flexible catalog\", \"rationale\": \"Flexibility reduces provider forecast certainty.\", \"row\": 7}"^^rdf:JSON .

pack-base:NEG-008 a skos:Concept ;
    skos:notation "NEG-008" ;
    skos:prefLabel "Capacity guarantee for committed spend"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'capacity guarantee' in exchange for 'committed spend'. Provider is compensated for reserved resources."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-R03, pack-base:CL-R01 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Committed spend\", \"provider_concession\": \"Capacity guarantee\", \"rationale\": \"Provider is compensated for reserved resources.\", \"row\": 8}"^^rdf:JSON .

pack-base:NEG-009 a skos:Concept ;
    skos:notation "NEG-009" ;
    skos:prefLabel "Shared savings for baseline and audit rights"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'shared savings' in exchange for 'baseline and audit rights'. Provider needs reliable attribution."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:CL-P07 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Baseline and audit rights\", \"provider_concession\": \"Shared savings\", \"rationale\": \"Provider needs reliable attribution.\", \"row\": 9}"^^rdf:JSON .

pack-base:NEG-010 a skos:Concept ;
    skos:notation "NEG-010" ;
    skos:prefLabel "Fixed fee for stronger change control"@en ;
    skos:definition "Negotiation exchange: the provider concedes 'fixed fee' in exchange for 'stronger change control'. Provider accepts cost risk only inside a bounded scope."@en ;
    skos:inScheme pack-base:scheme.negotiation_exchanges ;
    skos:related pack-base:PM-006, pack-base:CL-D11 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
