# --- glossary ------------------------------------------------------------------------------

cmv:Glossary a skos:ConceptScheme ;
    rdfs:label "Glossary of output terms"@en .

cmv:term.contractual_fee a skos:Concept ;
    skos:prefLabel "contractual_fee"@en ;
    skos:definition "Contractual consideration computed under the arrangement for a period. Not recognized revenue."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.gross_profit a skos:Concept ;
    skos:prefLabel "gross_profit"@en ;
    skos:definition "contractual_fee minus DIRECT_DELIVERY costs."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.contribution_profit a skos:Concept ;
    skos:prefLabel "contribution_profit"@en ;
    skos:definition "gross_profit minus ENGAGEMENT_AVOIDABLE costs. Layers partition costs, so nothing is subtracted twice."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.margin a skos:Concept ;
    skos:prefLabel "margin"@en ;
    skos:definition "(price - cost) / price. Not the same as markup, (price - cost) / cost."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.accumulation_period a skos:Concept ;
    skos:prefLabel "accumulation_period"@en ;
    skos:definition "The period over which an allowance, minimum, tier counter, or capacity limit accumulates: MONTH, QUARTER, YEAR, CONTRACT_YEAR, TERM."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.recognition a skos:Concept ;
    skos:prefLabel "recognition"@en ;
    skos:definition "When an accumulated effect is charged: CUMULATIVE (the month the threshold is crossed), PERIOD_END (true-up in the final month), PER_SEGMENT (monthly only)."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.margin_layer a skos:Concept ;
    skos:prefLabel "margin_layer"@en ;
    skos:definition "DIRECT_DELIVERY, ENGAGEMENT_AVOIDABLE, PORTFOLIO_SHARED, CORPORATE_OVERHEAD. A cost policy maps every cost category to exactly one layer."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.cost_policy a skos:Concept ;
    skos:prefLabel "cost_policy"@en ;
    skos:definition "Mapping from cost category to margin layer plus the transition-cost view. 'reference' is shipped and must be named explicitly."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.dominance a skos:Concept ;
    skos:prefLabel "dominance"@en ;
    skos:definition "Candidate X dominates Y when X is at least as good on every comparison metric and strictly better on one."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.derived_bearer a skos:Concept ;
    skos:prefLabel "derived_bearer"@en ;
    skos:definition "Who absorbs a deviation from the base scenario: PROVIDER (contribution falls), CLIENT (unit price rises), SHARED, or NONE_ADVERSE."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.realization a skos:Concept ;
    skos:prefLabel "realization"@en ;
    skos:definition "contractual_fee / standard_value, where standard_value is hours worked at the delivery plan's standard rate card. Below 1 is a write-down."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.outcome_fee a skos:Concept ;
    skos:prefLabel "outcome_fee"@en ;
    skos:definition "Fee from an OUTCOME_ADJUSTMENT component, measured over its accumulation period and charged at period end: SHARE of improvement against a baseline, SUCCESS amount at a target, or PERCENT_OF_OUTCOME. Needs attribution, a cap, and recorded approval."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.price_floor a skos:Concept ;
    skos:prefLabel "price_floor"@en ;
    skos:definition "(DIRECT_DELIVERY + ENGAGEMENT_AVOIDABLE costs + risk premium) / (1 - target margin). A decision formula, not a benchmark."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.evidence_class a skos:Concept ;
    skos:prefLabel "evidence_class"@en ;
    skos:definition "A_DIRECT, B_CORROBORATED, C_INFERENCE, D_PROPOSED. Independent of prevalence."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.origin a skos:Concept ;
    skos:prefLabel "origin"@en ;
    skos:definition "Every assumption is OBSERVED, CONTRACTED, ESTIMATED, ILLUSTRATIVE, or INTERNAL_POLICY."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.volume_shortfall a skos:Concept ;
    skos:prefLabel "volume_shortfall"@en ;
    skos:definition "Who absorbs volume below expected: CLIENT (pays for unused capacity or a minimum; its effective unit price rises), PROVIDER (its contribution falls), SHARED, or NONE_ADVERSE. The meaning derive_risk_exposure measures."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.volume_excess a skos:Concept ;
    skos:prefLabel "volume_excess"@en ;
    skos:definition "Who absorbs volume above expected: PROVIDER (more work for a fixed or capped fee), CLIENT, SHARED, or NONE_ADVERSE (paid per unit at the agreed rate)."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.spend_variability a skos:Concept ;
    skos:prefLabel "spend_variability"@en ;
    skos:definition "How the client's spend moves with volume: FIXED, BOUNDED (capped or banded), or VARIABLE."@en ;
    skos:inScheme cmv:Glossary .

cmv:term.structure_proposal a skos:Concept ;
    skos:prefLabel "structure_proposal"@en ;
    skos:definition "propose_structures output: candidates grouped by who absorbs a volume shortfall, never ranked, with labelled placeholders instead of figures. Pending human review."@en ;
    skos:inScheme cmv:Glossary .

# --- core model ----------------------------------------------------------------------------

cm:Engagement a owl:Class ;
    rdfs:label "Engagement"@en ;
    rdfs:comment "An evaluated client-provider relationship: parties, services, effective-dated arrangement versions, and an optional delivery plan."@en .

cm:Engagement.schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:string ;
    cm:fieldName "schema_version" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean ;
    cm:allowedValue "0.2" .

cm:Engagement.engagement_id a owl:DatatypeProperty ;
    rdfs:label "engagement_id"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:string ;
    cm:fieldName "engagement_id" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:string ;
    cm:fieldName "name" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.currency a owl:DatatypeProperty ;
    rdfs:label "currency"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:string ;
    cm:fieldName "currency" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.start_date a owl:DatatypeProperty ;
    rdfs:label "start_date"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:date ;
    cm:fieldName "start_date" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.end_date a owl:DatatypeProperty ;
    rdfs:label "end_date"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:date ;
    cm:fieldName "end_date" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.packs a owl:ObjectProperty ;
    rdfs:label "packs"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:PackRef ;
    cm:fieldName "packs" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Engagement.money_policy a owl:ObjectProperty ;
    rdfs:label "money_policy"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:MoneyPolicy ;
    cm:fieldName "money_policy" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.parties a owl:ObjectProperty ;
    rdfs:label "parties"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:Party ;
    cm:fieldName "parties" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Engagement.unit_definitions a owl:ObjectProperty ;
    rdfs:label "unit_definitions"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:UnitDefinition ;
    cm:fieldName "unit_definitions" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean ;
    cm:minItems "1"^^xsd:integer .

cm:Engagement.weight_tables a owl:ObjectProperty ;
    rdfs:label "weight_tables"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:ComplexityWeightTable ;
    cm:fieldName "weight_tables" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Engagement.services a owl:ObjectProperty ;
    rdfs:label "services"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:Service ;
    cm:fieldName "services" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean ;
    cm:minItems "1"^^xsd:integer .

cm:Engagement.arrangement_versions a owl:ObjectProperty ;
    rdfs:label "arrangement_versions"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:ArrangementVersion ;
    cm:fieldName "arrangement_versions" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean ;
    cm:minItems "1"^^xsd:integer .

cm:Engagement.delivery_plan a owl:ObjectProperty ;
    rdfs:label "delivery_plan"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:DeliveryPlan ;
    cm:fieldName "delivery_plan" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.risk_allocations a owl:ObjectProperty ;
    rdfs:label "risk_allocations"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range cm:RiskAllocation ;
    cm:fieldName "risk_allocations" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Engagement.descriptors a owl:DatatypeProperty ;
    rdfs:label "descriptors"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range rdf:JSON ;
    cm:fieldName "descriptors" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Engagement.client_value_unit a owl:DatatypeProperty ;
    rdfs:label "client_value_unit"@en ;
    rdfs:domain cm:Engagement ;
    rdfs:range xsd:string ;
    rdfs:comment "Scenario quantity used for effective client unit price: a name, \"weighted:<name>[:<table>]\", or names joined with + to sum commensurable units (\"docs_a+docs_b\"). Required when more than one unit type is priced."@en ;
    cm:fieldName "client_value_unit" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario a owl:Class ;
    rdfs:label "Scenario"@en ;
    rdfs:comment "A time-indexed set of assumptions that one or more arrangements are evaluated against."@en .

cm:Scenario.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range xsd:string ;
    cm:fieldName "id" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario.horizon a owl:ObjectProperty ;
    rdfs:label "horizon"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range cm:Horizon ;
    cm:fieldName "horizon" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario.assumptions a owl:ObjectProperty ;
    rdfs:label "assumptions"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range cm:Assumption ;
    cm:fieldName "assumptions" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Scenario.derived a owl:ObjectProperty ;
    rdfs:label "derived"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range cm:DerivedQuantity ;
    rdfs:comment "Quantities computed each month from assumptions, e.g. counting rules; usable anywhere a quantity_source is"@en ;
    cm:fieldName "derived" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "true"^^xsd:boolean .

cm:Scenario.breach_mode a owl:ObjectProperty ;
    rdfs:label "breach_mode"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range cmv:BreachMode ;
    cm:fieldName "breach_mode" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario.termination_date a owl:DatatypeProperty ;
    rdfs:label "termination_date"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range xsd:date ;
    rdfs:comment "Run the engagement as terminated on this date (inclusive): fees and costs stop, minimums follow each commitment's termination_rule, the version's termination_fee is charged, allowances expire, and unamortized one-time costs are written off."@en ;
    cm:fieldName "termination_date" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario.probability_label a owl:DatatypeProperty ;
    rdfs:label "probability_label"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range xsd:string ;
    cm:fieldName "probability_label" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Scenario.deviation_driver a owl:DatatypeProperty ;
    rdfs:label "deviation_driver"@en ;
    rdfs:domain cm:Scenario ;
    rdfs:range xsd:string ;
    cm:fieldName "deviation_driver" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:CostPolicy a owl:Class ;
    rdfs:label "CostPolicy"@en ;
    rdfs:comment "Mapping from cost category to margin layer, plus the transition-cost view."@en .

cm:CostPolicy.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:domain cm:CostPolicy ;
    rdfs:range xsd:string ;
    cm:fieldName "id" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:CostPolicy.version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:domain cm:CostPolicy ;
    rdfs:range xsd:string ;
    cm:fieldName "version" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean ;
    cm:defaultValue "1" .

cm:CostPolicy.owner a owl:DatatypeProperty ;
    rdfs:label "owner"@en ;
    rdfs:domain cm:CostPolicy ;
    rdfs:range xsd:string ;
    cm:fieldName "owner" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:CostPolicy.mapping a owl:DatatypeProperty ;
    rdfs:label "mapping"@en ;
    rdfs:domain cm:CostPolicy ;
    rdfs:range rdf:JSON ;
    cm:fieldName "mapping" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:CostPolicy.transition_view a owl:ObjectProperty ;
    rdfs:label "transition_view"@en ;
    rdfs:domain cm:CostPolicy ;
    rdfs:range cmv:TransitionView ;
    cm:fieldName "transition_view" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean ;
    cm:defaultValue "INCURRED" .

cm:TolerancePolicy a owl:Class ;
    rdfs:label "TolerancePolicy"@en ;
    rdfs:comment "Relative deviations treated as adverse when deriving who bears risk."@en .

cm:TolerancePolicy.provider_relative a owl:DatatypeProperty ;
    rdfs:label "provider_relative"@en ;
    rdfs:domain cm:TolerancePolicy ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fraction of base contribution treated as adverse"@en ;
    cm:fieldName "provider_relative" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:TolerancePolicy.client_relative a owl:DatatypeProperty ;
    rdfs:label "client_relative"@en ;
    rdfs:domain cm:TolerancePolicy ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fraction of base unit price treated as adverse"@en ;
    cm:fieldName "client_relative" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:PackRef a owl:Class ;
    rdfs:label "PackRef"@en ;
    rdfs:comment "A domain pack the engagement declares, optionally pinned to a version."@en .

cm:PackRef.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:domain cm:PackRef ;
    rdfs:range xsd:string ;
    cm:fieldName "id" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:PackRef.version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:domain cm:PackRef ;
    rdfs:range xsd:string ;
    cm:fieldName "version" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:MoneyPolicy a owl:Class ;
    rdfs:label "MoneyPolicy"@en ;
    rdfs:comment "Rounding mode, scale, and level for money amounts."@en .

cm:MoneyPolicy.rounding_mode a owl:ObjectProperty ;
    rdfs:label "rounding_mode"@en ;
    rdfs:domain cm:MoneyPolicy ;
    rdfs:range cmv:RoundingMode ;
    cm:fieldName "rounding_mode" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean ;
    cm:defaultValue "HALF_UP" .

cm:MoneyPolicy.rounding_scale a owl:DatatypeProperty ;
    rdfs:label "rounding_scale"@en ;
    rdfs:domain cm:MoneyPolicy ;
    rdfs:range xsd:integer ;
    cm:fieldName "rounding_scale" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:MoneyPolicy.rounding_level a owl:ObjectProperty ;
    rdfs:label "rounding_level"@en ;
    rdfs:domain cm:MoneyPolicy ;
    rdfs:range cmv:RoundingLevel ;
    cm:fieldName "rounding_level" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean ;
    cm:defaultValue "LINE_ITEM" .

cm:Party a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "A contract party: client, provider, or subcontractor."@en .

cm:Party.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:domain cm:Party ;
    rdfs:range xsd:string ;
    cm:fieldName "id" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Party.role a owl:ObjectProperty ;
    rdfs:label "role"@en ;
    rdfs:domain cm:Party ;
    rdfs:range cmv:PartyRole ;
    cm:fieldName "role" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Party.provider_type a owl:DatatypeProperty ;
    rdfs:label "provider_type"@en ;
    rdfs:domain cm:Party ;
    rdfs:range xsd:string ;
    cm:fieldName "provider_type" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Party.jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction"@en ;
    rdfs:domain cm:Party ;
    rdfs:range xsd:string ;
    cm:fieldName "jurisdiction" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:Party.regulated_status a owl:DatatypeProperty ;
    rdfs:label "regulated_status"@en ;
    rdfs:domain cm:Party ;
    rdfs:range xsd:string ;
    cm:fieldName "regulated_status" ;
    cm:required "false"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:UnitDefinition a owl:Class ;
    rdfs:label "UnitDefinition"@en ;
    rdfs:comment "An unambiguous measurable unit of work, with its counting and acceptance rules."@en .

cm:UnitDefinition.code a owl:DatatypeProperty ;
    rdfs:label "code"@en ;
    rdfs:domain cm:UnitDefinition ;
    rdfs:range xsd:string ;
    cm:fieldName "code" ;
    cm:required "true"^^xsd:boolean ;
    cm:multiple "false"^^xsd:boolean .

cm:UnitDefinition.kind a owl:ObjectProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain cm:UnitDefinition ;
    rdfs:range cmv:UnitKind ;
    cm:fieldName "kind" ;
    cm:required "false"^^xsd:boolean ;
