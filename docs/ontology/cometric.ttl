pack-alsp:CLM-A-0005 a cm:Claim ;
    skos:notation "CLM-A-0005" ;
    cm:pack pack-alsp:pack ;
    cm:statement "A 2025 corporate legal-department benchmarking report treats fee structures as heterogeneous across practice areas."@en ;
