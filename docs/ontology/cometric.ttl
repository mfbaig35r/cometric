    cm:attributes "{\"cadence_note\": \"event cadence\", \"calculation\": \"Fee = Sum(MilestonePayment_j)\", \"core_basis\": \"FIXED\", \"economic_object\": \"Completion or acceptance event\", \"row\": 8}"^^rdf:JSON .

pack-base:BB-COST a skos:Concept ;
    skos:notation "BB-COST" ;
    skos:prefLabel "Cost"@en ;
    skos:definition "Billing basis whose economic object purchased is: provider-incurred eligible cost. Fundamental calculation: Fee = EligibleCost + Markup."@en ;
