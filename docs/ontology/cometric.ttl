    cm:status "active" ;
    cm:attributes "{\"applications\": \"Prompts, documents, pages, tokens, agent actions, processing.\", \"formula\": null, \"provider_client_economics\": \"Aligns variable technology costs but can reduce budget predictability.\", \"source_basis\": [\"BB-USAGE\"]}"^^rdf:JSON .

pack-base:PM-031 a skos:Concept ;
    skos:notation "PM-031" ;
    skos:prefLabel "Service-credit subscription or prepaid credits"@en ;
    skos:altLabel "prepaid credits"@en, "credit subscription"@en ;
