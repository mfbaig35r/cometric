pack-base:scheme.client_priorities a skos:ConceptScheme ;
    rdfs:label "Client priorities for structure proposals"@en ;
    skos:notation "client_priorities" ;
    cm:pack pack-base:pack .

pack-base:budget_certainty a skos:Concept ;
    skos:notation "budget_certainty" ;
    skos:prefLabel "Budget certainty"@en ;
    skos:altLabel "predictable spend"@en, "cost certainty"@en ;
    skos:definition "The client wants to know what it will spend. Served by structures whose spend is fixed or bounded."@en ;
    skos:inScheme pack-base:scheme.client_priorities ;
    skos:related pack-base:SEL-007 ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "cometric:design" ;
    cm:status "active" ;
    cm:attributes "{\"fits\": {\"in\": [\"FIXED\", \"BOUNDED\"], \"path\": \"labels.spend_variability\"}, \"suggests\": [\"CL-V07\"], \"tension\": {\"equals\": \"VARIABLE\", \"path\": \"labels.spend_variability\"}, \"tension_note\": \"Spend moves with volume.\"}"^^rdf:JSON .

pack-base:pay_for_use a skos:Concept ;
    skos:notation "pay_for_use" ;
    skos:prefLabel "Pay for use"@en ;
    skos:altLabel "flexibility"@en, "pay as you go"@en ;
    skos:definition "The client wants to pay for the work it sends and not for unused capacity. Served by structures where the client does not absorb a volume shortfall."@en ;
    skos:inScheme pack-base:scheme.client_priorities ;
    skos:related pack-base:SEL-008 ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "cometric:design" ;
    cm:status "active" ;
    cm:attributes "{\"fits\": {\"all\": [{\"not\": {\"equals\": \"CLIENT\", \"path\": \"labels.volume_shortfall\"}}, {\"not\": {\"equals\": \"FIXED\", \"path\": \"labels.spend_variability\"}}]}, \"suggests\": [\"CL-R06\"], \"tension\": {\"equals\": \"CLIENT\", \"path\": \"labels.volume_shortfall\"}, \"tension_note\": \"The client pays for capacity it does not use.\"}"^^rdf:JSON .

pack-base:cost_reduction_over_time a skos:Concept ;
    skos:notation "cost_reduction_over_time" ;
    skos:prefLabel "Cost reduction over time"@en ;
    skos:altLabel "savings with scale"@en ;
    skos:definition "The client wants its unit cost to fall as volume grows. Served by volume bands, discounts, or rebates."@en ;
    skos:inScheme pack-base:scheme.client_priorities ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "cometric:design" ;
    cm:status "active" ;
    cm:attributes "{\"fits\": {\"any\": [{\"equals\": \"PM-014\", \"path\": \"base_model\"}, {\"in\": [\"CL-V04\", \"CL-V05\"], \"path\": \"levers[*]\"}]}, \"suggests\": [\"CL-V04\", \"CL-V05\"], \"tension\": {\"not\": {\"any\": [{\"equals\": \"PM-014\", \"path\": \"base_model\"}, {\"in\": [\"CL-V04\", \"CL-V05\"], \"path\": \"levers[*]\"}]}}, \"tension_note\": \"Nothing lowers the price as volume grows.\"}"^^rdf:JSON .

pack-base:outcome_alignment a skos:Concept ;
    skos:notation "outcome_alignment" ;
    skos:prefLabel "Outcome alignment"@en ;
    skos:altLabel "performance alignment"@en ;
    skos:definition "The client wants the provider's fees to respond to service performance. Served by service credits or performance bonuses."@en ;
    skos:inScheme pack-base:scheme.client_priorities ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:caveat "Outcome-based fees (gain-share"@en, "success fees) are not proposed in this version."@en ;
    cm:sourceRef "cometric:design" ;
    cm:status "active" ;
    cm:attributes "{\"fits\": {\"in\": [\"CL-P01\", \"CL-P02\"], \"path\": \"levers[*]\"}, \"suggests\": [\"CL-P01\", \"CL-P02\"], \"tension\": {\"not\": {\"in\": [\"CL-P01\", \"CL-P02\"], \"path\": \"levers[*]\"}}, \"tension_note\": \"Fees do not respond to service performance.\"}"^^rdf:JSON .

pack-base:simplicity a skos:Concept ;
    skos:notation "simplicity" ;
    skos:prefLabel "Simplicity"@en ;
    skos:altLabel "easy to administer"@en ;
    skos:definition "The client wants a structure that is easy to understand and administer. Served by structures with at most one lever."@en ;
    skos:inScheme pack-base:scheme.client_priorities ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:sourceRef "cometric:design" ;
    cm:status "active" ;
    cm:attributes "{\"fits\": {\"lte\": 1, \"path\": \"lever_count\"}, \"suggests\": [], \"tension\": {\"gte\": 3, \"path\": \"lever_count\"}, \"tension_note\": \"Several mechanisms to administer.\"}"^^rdf:JSON .

pack-base:scheme.cost_categories a skos:ConceptScheme ;
    rdfs:label "Cost categories and allocation guidance"@en ;
    skos:notation "cost_categories" ;
    cm:pack pack-base:pack .

pack-base:COST-01 a skos:Concept ;
