    cm:sourceRef "report:FM-024" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": \"Revenue / AverageDeliveryFTE\", \"limitation\": \"Mix and automation make comparisons imperfect.\", \"requires\": null, \"unit_period\": \"currency / FTE\"}"^^rdf:JSON .

pack-base:FM-025 a skos:Concept ;
    skos:notation "FM-025" ;
    skos:prefLabel "Revenue per productive hour"@en ;
    skos:definition "Revenue divided by productive delivery hours."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-025" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": \"Revenue / ProductiveDeliveryHours\", \"limitation\": \"Can increase when AI reduces human hours.\", \"requires\": null, \"unit_period\": \"currency / hour\"}"^^rdf:JSON .

pack-base:FM-026 a skos:Concept ;
    skos:notation "FM-026" ;
    skos:prefLabel "Utilization"@en ;
    skos:definition "Productive hours divided by available working hours."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-026" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"productive_hours_utilization\", \"family\": \"financial\", \"formula\": \"ProductiveHours / AvailableWorkingHours\", \"limitation\": \"Definition varies; 'productive' may include nonbillable client work.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-027 a skos:Concept ;
    skos:notation "FM-027" ;
    skos:prefLabel "Billable utilization"@en ;
    skos:definition "Billable hours divided by available hours."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-027" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": \"BillableHours / AvailableHours\", \"limitation\": \"Not useful as the sole metric in output pricing.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-028 a skos:Concept ;
    skos:notation "FM-028" ;
    skos:prefLabel "Realization"@en ;
    skos:definition "Billed value divided by standard or worked value, according to policy."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-028" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"realization\", \"family\": \"financial\", \"formula\": \"BilledValue / StandardOrWorkedValue\", \"limitation\": \"Definitions vary between organizations.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-029 a skos:Concept ;
    skos:notation "FM-029" ;
    skos:prefLabel "Collection rate"@en ;
    skos:definition "Cash collected divided by the billed amount for a comparable cohort."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-029" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": \"CashCollected / BilledAmount\", \"limitation\": \"Cohort timing needed; otherwise distortions occur.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-030 a skos:Concept ;
    skos:notation "FM-030" ;
    skos:prefLabel "Unit contribution"@en ;
    skos:definition "Unit price less unit variable cost."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-030" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"unit_contribution\", \"family\": \"financial\", \"formula\": \"UnitPrice - UnitVariableCost\", \"limitation\": \"Only valid if the unit is homogeneous or normalized.\", \"requires\": null, \"unit_period\": \"currency / unit\"}"^^rdf:JSON .

pack-base:FM-031 a skos:Concept ;
    skos:notation "FM-031" ;
    skos:prefLabel "Break-even volume"@en ;
    skos:definition "Volume at which contribution reaches zero, where algebraically appropriate."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0025 ;
    cm:sourceRef "report:FM-031" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"break_even_volume\", \"family\": \"financial\", \"formula\": \"Q_BE = (FixedCost - FixedRevenue) / (UnitPrice - UnitVariableCost)\", \"limitation\": \"Piecewise fees require a piecewise solution.\", \"requires\": null, \"unit_period\": \"units\"}"^^rdf:JSON .

pack-base:FM-032 a skos:Concept ;
    skos:notation "FM-032" ;
    skos:prefLabel "Capacity utilization"@en ;
    skos:definition "Actual capacity consumed divided by usable committed capacity."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0026 ;
    cm:sourceRef "report:FM-032" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"capacity_utilization\", \"family\": \"financial\", \"formula\": \"ConsumedCapacity / UsableCommittedCapacity\", \"limitation\": \"Different from personnel billable utilization.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-033 a skos:Concept ;
    skos:notation "FM-033" ;
    skos:prefLabel "Cost to serve"@en ;
    skos:definition "Attributable delivery and support cost for an account or service."@en ;
