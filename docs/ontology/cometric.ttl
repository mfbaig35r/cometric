pack-base:CHI-012 a skos:Concept ;
    skos:notation "CHI-012" ;
    skos:prefLabel "Effective cost trend"@en ;
    skos:definition "Detects rising unit economics despite fixed spend. Computed as Current cost per unit versus prior normalized periods."@en ;
