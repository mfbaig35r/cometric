pack-alsp:CLM-A-0006 a cm:Claim ;
    skos:notation "CLM-A-0006" ;
    cm:pack pack-alsp:pack ;
    cm:statement "2025 corporate law-department research found 77% of external legal spend billed hourly, 18% through value-based arrangements and 5% through monthly or annual retainers; these figures concern law-firm spend and are not ALSP prevalence benchmarks."@en ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
