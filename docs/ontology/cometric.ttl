    cm:calculationMethod cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0008, pack-base:CLM-B-0009 ;
    cm:sourceRef "report:PM-034" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Technology-heavy managed service with minimum spend and overage.\", \"formula\": null, \"provider_client_economics\": \"Discount in exchange for a revenue floor; creates under-consumption risk for the client.\", \"source_basis\": [\"BB-USAGE\"]}"^^rdf:JSON .

