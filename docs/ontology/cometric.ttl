    cm:sourceRef "report:PM-032" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Defense and avoided-loss economics.\", \"formula\": null, \"provider_client_economics\": \"Requires a credible avoided-loss baseline; may create high outcome volatility.\", \"source_basis\": [\"BB-OUTCOME\"]}"^^rdf:JSON .

pack-base:PM-033 a skos:Concept ;
    skos:notation "PM-033" ;
    skos:prefLabel "Performance holdback"@en ;
    skos:altLabel "holdback"@en, "fee at risk"@en ;
    skos:definition "Part of the base fee is held at risk and paid only if defined performance conditions are met."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-025, pack-base:CL-P02 ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:sourceRef "report:PM-033" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Matters or managed services where part of the fee depends on performance.\", \"formula\": \"Base fee minus at-risk percentage\", \"provider_client_economics\": \"Creates measurable downside without making the total fee wholly contingent.\", \"source_basis\": []}"^^rdf:JSON .

pack-base:PM-034 a skos:Concept ;
    skos:notation "PM-034" ;
    skos:prefLabel "Committed consumption or take-or-pay usage"@en ;
    skos:altLabel "committed use"@en, "take-or-pay usage"@en ;
    skos:definition "A usage-based service with a minimum spend commitment, typically exchanged for a discount, with overage beyond it."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
