pack-base:MAR-001 a skos:Concept ;
    skos:notation "MAR-001" ;
    skos:prefLabel "Margin-at-Risk"@en ;
    skos:definition "Proposed measure of downside in contribution: target contribution less a chosen lower quantile of the simulated contribution distribution."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0028, pack-base:CLM-B-0027 ;
    cm:caveat "The report classifies this C/D for management use unless an organization defines it formally."@en, "Not computed in v1; requires calibrated probability distributions."@en ;
    cm:sourceRef "report:demand-uncertainty" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"risk\", \"formula\": \"MaR_alpha = TargetContribution - Quantile_alpha(Contribution)\", \"limitation\": \"Meaningful only with empirically calibrated distributions.\", \"requires\": \"distributions\", \"unit_period\": \"currency / scenario horizon\"}"^^rdf:JSON .

pack-base:MAR-002 a skos:Concept ;
    skos:notation "MAR-002" ;
    skos:prefLabel "Client Value-at-Risk"@en ;
    skos:definition "Candidate advisory measure of downside in realized client value relative to committed spend."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.D_PROPOSED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
