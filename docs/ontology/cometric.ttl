# --- pack base -----------------------------------------------------------------------------

pack-base:pack a cm:Pack ;
    rdfs:label "Base commercial knowledge"@en ;
    rdfs:comment "Domain-neutral commercial-arrangement knowledge: billing bases, pricing models, levers, dimensions, metrics, cost categories, compatibility and reasoning rules, and cross-sector evidence."@en ;
    owl:versionInfo "0.2.0" .

pack-base:scheme.automation_structures a skos:ConceptScheme ;
    rdfs:label "Structures for automation-reduced effort"@en ;
    skos:notation "automation_structures" ;
    cm:pack pack-base:pack .

pack-base:AUTO-01 a skos:Concept ;
    skos:notation "AUTO-01" ;
    skos:prefLabel "Time plus technology fee"@en ;
    skos:definition "A defensible structure for pricing a service whose human effort has been sharply reduced by automation."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:PM-001 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0032, pack-base:CLM-B-0031 ;
    cm:sourceRef "report:automation-structures" ;
    cm:status "active" ;
    cm:attributes "{\"benefit_allocation_note\": \"Benefit largely passes to the client through reduced hours.\", \"client_perspective\": \"Transparent inputs.\", \"principal_risk\": \"Client may expect full labor savings; provider monetizes less productivity upside.\", \"provider_perspective\": \"Easy transition from legacy billing; technology cost recoverable.\", \"row\": 1}"^^rdf:JSON .

pack-base:AUTO-02 a skos:Concept ;
    skos:notation "AUTO-02" ;
    skos:prefLabel "Fixed fee for defined output"@en ;
    skos:definition "A defensible structure for pricing a service whose human effort has been sharply reduced by automation."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:PM-006, pack-base:PM-007 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0032, pack-base:CLM-B-0031 ;
    cm:sourceRef "report:automation-structures" ;
    cm:status "active" ;
    cm:attributes "{\"benefit_allocation_note\": \"Benefit is provider-retained until competition or contract terms pass savings through.\", \"client_perspective\": \"Budget certainty and incentive for efficiency.\", \"principal_risk\": \"Provider bears error, volume and scope risk.\", \"provider_perspective\": \"Provider captures productivity improvements.\", \"row\": 2}"^^rdf:JSON .

pack-base:AUTO-03 a skos:Concept ;
    skos:notation "AUTO-03" ;
    skos:prefLabel "Per-contract or per-unit fee"@en ;
    skos:definition "A defensible structure for pricing a service whose human effort has been sharply reduced by automation."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:PM-011, pack-base:PM-012 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0032, pack-base:CLM-B-0031 ;
    cm:sourceRef "report:automation-structures" ;
    cm:status "active" ;
    cm:attributes "{\"benefit_allocation_note\": \"Benefit is provider-retained at a given unit price.\", \"client_perspective\": \"Clear linkage to consumption.\", \"principal_risk\": \"Complexity variation and falling market prices.\", \"provider_perspective\": \"Scales with demand; AI efficiency improves contribution.\", \"row\": 3}"^^rdf:JSON .

pack-base:AUTO-04 a skos:Concept ;
    skos:notation "AUTO-04" ;
    skos:prefLabel "Base platform or capacity plus unit fee"@en ;
    skos:definition "A defensible structure for pricing a service whose human effort has been sharply reduced by automation."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:PM-023, pack-base:PM-029 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0032, pack-base:CLM-B-0031 ;
    cm:sourceRef "report:automation-structures" ;
    cm:status "active" ;
    cm:attributes "{\"benefit_allocation_note\": \"Allocation depends on how base and unit rates are set.\", \"client_perspective\": \"Separates fixed capability from use.\", \"principal_risk\": \"Requires defensible base and unit definitions.\", \"provider_perspective\": \"Recovers fixed engineering and readiness costs plus variable processing.\", \"row\": 4}"^^rdf:JSON .

pack-base:AUTO-05 a skos:Concept ;
    skos:notation "AUTO-05" ;
    skos:prefLabel "Shared-savings or outcome fee"@en ;
    skos:definition "A defensible structure for pricing a service whose human effort has been sharply reduced by automation."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:PM-026, pack-base:PM-024 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0032, pack-base:CLM-B-0031 ;
    cm:caveat "Requires outcome pricing support in the core (post-v1)."@en ;
    cm:sourceRef "report:automation-structures" ;
    cm:status "active" ;
    cm:attributes "{\"benefit_allocation_note\": \"Benefit is shared by formula.\", \"client_perspective\": \"Client pays from realized benefit.\", \"principal_risk\": \"Baseline and attribution disputes.\", \"provider_perspective\": \"Can monetize demonstrable transformation value.\", \"row\": 5}"^^rdf:JSON .

pack-base:AUTOBEN-01 a skos:Concept ;
    skos:notation "AUTOBEN-01" ;
    skos:prefLabel "Provider-retained automation benefit"@en ;
    skos:definition "Provider-retained automation benefit creates the strongest incentive to invest but may invite competitive repricing."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:DIM-09 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0033, pack-base:CLM-B-0031 ;
    cm:caveat "There is no credible evidence of a universal automation-savings sharing percentage."@en ;
    cm:sourceRef "report:automation-benefit" ;
    cm:status "active" ;
    cm:attributes "{\"dimension_value\": \"PROVIDER_RETAINED\"}"^^rdf:JSON .

pack-base:AUTOBEN-02 a skos:Concept ;
    skos:notation "AUTOBEN-02" ;
    skos:prefLabel "Client-retained automation benefit"@en ;
    skos:definition "Client-retained benefit accelerates adoption but can make provider investment unattractive."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:DIM-09 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0034, pack-base:CLM-B-0031 ;
    cm:caveat "There is no credible evidence of a universal automation-savings sharing percentage."@en ;
    cm:sourceRef "report:automation-benefit" ;
    cm:status "active" ;
    cm:attributes "{\"dimension_value\": \"CLIENT_RETAINED\"}"^^rdf:JSON .

pack-base:AUTOBEN-03 a skos:Concept ;
    skos:notation "AUTOBEN-03" ;
    skos:prefLabel "Shared automation benefit"@en ;
    skos:definition "Shared benefit can align incentives but increases measurement complexity."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:DIM-09 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0035, pack-base:CLM-B-0031 ;
    cm:caveat "There is no credible evidence of a universal automation-savings sharing percentage."@en ;
    cm:sourceRef "report:automation-benefit" ;
    cm:status "active" ;
    cm:attributes "{\"dimension_value\": \"SHARED\"}"^^rdf:JSON .

pack-base:AUTOBEN-04 a skos:Concept ;
    skos:notation "AUTOBEN-04" ;
    skos:prefLabel "Productivity glide path"@en ;
    skos:definition "Productivity glide paths create a contractual schedule for passing efficiencies through over time and have direct precedent in broader outsourcing."@en ;
    skos:inScheme pack-base:scheme.automation_structures ;
    skos:related pack-base:DIM-09 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0036, pack-base:CLM-B-0031 ;
    cm:caveat "There is no credible evidence of a universal automation-savings sharing percentage."@en ;
    cm:sourceRef "report:automation-benefit" ;
    cm:status "active" ;
    cm:attributes "{\"dimension_value\": \"GLIDE_PATH\"}"^^rdf:JSON .

pack-base:scheme.billing_bases a skos:ConceptScheme ;
    rdfs:label "Normalized foundational billing bases"@en ;
    skos:notation "billing_bases" ;
    cm:pack pack-base:pack .

pack-base:BB-TIME a skos:Concept ;
    skos:notation "BB-TIME" ;
    skos:prefLabel "Time"@en ;
    skos:definition "Billing basis whose economic object purchased is: professional effort. Fundamental calculation: Fee = Time * Rate."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
    skos:related pack-base:PM-001, pack-base:PM-002, pack-base:PM-003, pack-base:PM-020 ;
