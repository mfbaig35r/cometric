    cm:sourceRef "report:negotiation-exchanges" ;
    cm:status "active" ;
    cm:attributes "{\"client_concession\": \"Stronger change control\", \"provider_concession\": \"Fixed fee\", \"rationale\": \"Provider accepts cost risk only inside a bounded scope.\", \"row\": 10}"^^rdf:JSON .

pack-base:scheme.offers a skos:ConceptScheme ;
    rdfs:label "Three defensible offers for one engagement"@en ;
    skos:notation "offers" ;
    cm:pack pack-base:pack .

pack-base:OFFER-A a skos:Concept ;
    skos:notation "OFFER-A" ;
    skos:prefLabel "Low commitment, high variable"@en ;
    skos:definition "One of three defensible offers for the same recurring contract-review service. Annual base fee of $400,000 (illustrative) plus higher unit charges."@en ;
    skos:inScheme pack-base:scheme.offers ;
    skos:related pack-base:PM-023, pack-base:CL-R10 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:caveat "Dollar amounts are illustrative figures from the report, not benchmarks."@en, "None of the three offers is universally superior; selection depends on demand distribution, availability needs, client budget preferences and provider redeployment capability."@en ;
    cm:sourceRef "report:three-offers" ;
    cm:status "active" ;
    cm:attributes "{\"illustrative\": true, \"structure\": \"Annual base fee of $400,000 (illustrative) plus higher unit charges.\", \"tradeoff\": \"Maximizes client flexibility but gives the provider less revenue certainty.\"}"^^rdf:JSON .

pack-base:OFFER-B a skos:Concept ;
    skos:notation "OFFER-B" ;
    skos:prefLabel "High commitment, lower marginal"@en ;
    skos:definition "One of three defensible offers for the same recurring contract-review service. Annual minimum of $800,000 (illustrative) including a substantial allowance, plus reduced overage."@en ;
    skos:inScheme pack-base:scheme.offers ;
    skos:related pack-base:CL-R01, pack-base:CL-V01, pack-base:CL-V02 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:caveat "Dollar amounts are illustrative figures from the report, not benchmarks."@en, "None of the three offers is universally superior; selection depends on demand distribution, availability needs, client budget preferences and provider redeployment capability."@en ;
    cm:sourceRef "report:three-offers" ;
    cm:status "active" ;
    cm:attributes "{\"illustrative\": true, \"structure\": \"Annual minimum of $800,000 (illustrative) including a substantial allowance, plus reduced overage.\", \"tradeoff\": \"Transfers under-consumption risk toward the client but supports lower marginal pricing.\"}"^^rdf:JSON .

pack-base:OFFER-C a skos:Concept ;
    skos:notation "OFFER-C" ;
    skos:prefLabel "Dedicated capacity"@en ;
    skos:definition "One of three defensible offers for the same recurring contract-review service. Fixed annual FTE or capacity charge plus separately priced overflow."@en ;
    skos:inScheme pack-base:scheme.offers ;
    skos:related pack-base:PM-004, pack-base:PM-009, pack-base:CL-R03 ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0004 ;
    cm:caveat "None of the three offers is universally superior; selection depends on demand distribution, availability needs, client budget preferences and provider redeployment capability."@en ;
    cm:sourceRef "report:three-offers" ;
    cm:status "active" ;
    cm:attributes "{\"illustrative\": true, \"structure\": \"Fixed annual FTE or capacity charge plus separately priced overflow.\", \"tradeoff\": \"Maximizes continuity and availability but exposes the client to value concerns if capacity is unused.\"}"^^rdf:JSON .

pack-base:scheme.pricing_models a skos:ConceptScheme ;
    rdfs:label "Pricing model catalog"@en ;
    skos:notation "pricing_models" ;
    cm:pack pack-base:pack .

pack-base:PM-001 a skos:Concept ;
    skos:notation "PM-001" ;
    skos:prefLabel "Hourly time and materials"@en ;
    skos:altLabel "time and materials"@en, "T&M"@en, "hourly"@en ;
    skos:definition "Fees equal recorded, approved hours multiplied by hourly rates; the client buys professional effort."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-002, pack-base:PM-003, pack-base:PM-020 ;
    cm:billingBasis cmv:BillingBasis.TIME ;
    cm:calculationMethod cmv:CalculationMethod.TIME ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-001" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Advisory, project work, uncertain scope. Invoice triggered by recorded approved time.\", \"formula\": \"F = Sum_r(h_r * r_r)\", \"provider_client_economics\": \"Low provider scope risk; client carries duration and productivity risk. Revenue variable; cost visibility moderate.\", \"source_basis\": [\"BB-TIME\"]}"^^rdf:JSON .

pack-base:PM-002 a skos:Concept ;
    skos:notation "PM-002" ;
    skos:prefLabel "Blended hourly rate"@en ;
    skos:altLabel "blended rate"@en ;
    skos:definition "A single averaged hourly rate applied to all hours worked by a multi-level team."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:broader pack-base:PM-001 ;
    skos:related pack-base:PM-001, pack-base:CL-D04 ;
    cm:billingBasis cmv:BillingBasis.TIME ;
    cm:calculationMethod cmv:CalculationMethod.TIME ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-002" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Multi-level teams where one averaged rate reduces rate-card complexity.\", \"formula\": \"F = H * r_b\", \"provider_client_economics\": \"Simplifies budgeting; creates a provider incentive to optimize seniority mix and a risk of adverse mix if senior input exceeds assumptions.\", \"source_basis\": [\"BB-TIME\"]}"^^rdf:JSON .

pack-base:PM-003 a skos:Concept ;
    skos:notation "PM-003" ;
    skos:prefLabel "Role or seniority rate card"@en ;
    skos:altLabel "rate card"@en, "role-based rates"@en ;
    skos:definition "Time-based pricing in which hourly rates are indexed to role, seniority or skill."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:broader pack-base:PM-001 ;
    skos:related pack-base:PM-001, pack-base:CL-D04 ;
    cm:billingBasis cmv:BillingBasis.TIME ;
    cm:calculationMethod cmv:CalculationMethod.TIME ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-003" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Consulting, technology implementation, legal operations.\", \"formula\": null, \"provider_client_economics\": \"Transparent labor pricing but exposes the client to hours and mix.\", \"source_basis\": [\"BB-TIME\"]}"^^rdf:JSON .

pack-base:PM-004 a skos:Concept ;
    skos:notation "PM-004" ;
    skos:prefLabel "Dedicated FTE or resource unit"@en ;
    skos:altLabel "FTE pricing"@en, "dedicated resource"@en ;
    skos:definition "The client pays per dedicated full-time-equivalent resource per period, purchasing dedicated resource capacity."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-009, pack-base:CL-D01, pack-base:CL-R03 ;
    cm:billingBasis cmv:BillingBasis.RESOURCE ;
    cm:calculationMethod cmv:CalculationMethod.DEDICATED_RESOURCE ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0048 ;
    cm:sourceRef "report:PM-004" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Ongoing legal operations, contract teams, processing teams.\", \"formula\": \"F = N_FTE * R_FTE\", \"provider_client_economics\": \"Predictable revenue and cost; low utilization becomes a client-value issue; high demand can create overtime or capacity pressure.\", \"source_basis\": [\"BB-RESOURCE\"]}"^^rdf:JSON .

pack-base:PM-005 a skos:Concept ;
    skos:notation "PM-005" ;
    skos:prefLabel "Staff augmentation or secondment"@en ;
    skos:altLabel "secondment"@en, "staff augmentation"@en ;
    skos:definition "The provider supplies resources who work under client direction, priced per resource period or by time."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-004, pack-base:PM-001 ;
    cm:billingBasis cmv:BillingBasis.RESOURCE, cmv:BillingBasis.TIME ;
    cm:calculationMethod cmv:CalculationMethod.DEDICATED_RESOURCE, cmv:CalculationMethod.TIME ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-005" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Temporary gaps, specialist work, workload spikes.\", \"formula\": null, \"provider_client_economics\": \"Client controls the work; provider assumes less output risk.\", \"source_basis\": [\"BB-RESOURCE\", \"BB-TIME\"]}"^^rdf:JSON .

pack-base:PM-006 a skos:Concept ;
    skos:notation "PM-006" ;
    skos:prefLabel "Fixed-fee project"@en ;
    skos:altLabel "fixed fee"@en, "fixed price project"@en ;
    skos:definition "A single fixed fee for a defined scope, regardless of the effort required."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-D10, pack-base:CL-D11, pack-base:PM-017 ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_PROJECT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0049 ;
    cm:sourceRef "report:PM-006" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"CLM implementation, remediation, migration, reviews.\", \"formula\": \"F = F_0 for defined scope\", \"provider_client_economics\": \"Provider assumes effort and cost-overrun risk; client gains budget certainty. Requires scope and change control.\", \"source_basis\": [\"BB-FIXED\"]}"^^rdf:JSON .

pack-base:PM-007 a skos:Concept ;
    skos:notation "PM-007" ;
    skos:prefLabel "Fixed-fee managed service"@en ;
    skos:altLabel "fixed managed service"@en ;
    skos:definition "A recurring fixed fee for an ongoing defined service for which the provider is accountable for output and service levels."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-P01, pack-base:CL-V07, pack-base:CL-V08, pack-base:PM-028 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0005, pack-base:CLM-B-0043 ;
    cm:sourceRef "report:PM-007" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Ongoing defined service with the provider accountable for output and SLA.\", \"formula\": null, \"normalization\": \"Managed service describes accountability and delivery architecture, not necessarily the billing basis.\", \"provider_client_economics\": \"Revenue highly predictable; volume and cost risk may sit with the provider unless bounded.\", \"source_basis\": [\"BB-FIXED\", \"BB-RECURRING\"]}"^^rdf:JSON .

pack-base:PM-008 a skos:Concept ;
    skos:notation "PM-008" ;
    skos:prefLabel "Monthly or annual retainer"@en ;
    skos:altLabel "retainer"@en ;
    skos:definition "A periodic fixed fee for access to expertise or defined ongoing support."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-R04 ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-008" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Access to expertise or defined ongoing support.\", \"formula\": null, \"provider_client_economics\": \"Predictable spend and revenue; underutilization can raise value concerns.\", \"source_basis\": [\"BB-RECURRING\"]}"^^rdf:JSON .

pack-base:PM-009 a skos:Concept ;
    skos:notation "PM-009" ;
    skos:prefLabel "Capacity reservation"@en ;
    skos:altLabel "reserved capacity"@en ;
    skos:definition "The client pays for reserved availability or throughput, whether or not it is used."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-R03, pack-base:PM-004, pack-base:MECH-002 ;
    cm:billingBasis cmv:BillingBasis.CAPACITY ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0010 ;
    cm:sourceRef "report:PM-009" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Reserved lawyers, reviewers, processing slots, service desk throughput.\", \"formula\": \"Fee = ReservedCapacity * CapacityRate\", \"provider_client_economics\": \"Client pays for availability; provider must preserve capacity whether used or not.\", \"source_basis\": [\"BB-CAPACITY\"]}"^^rdf:JSON .

pack-base:PM-010 a skos:Concept ;
    skos:notation "PM-010" ;
    skos:prefLabel "Subscription service"@en ;
    skos:altLabel "subscription"@en ;
    skos:definition "A recurring charge for ongoing access to a platform and service bundle, sometimes with a capacity entitlement."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-031, pack-base:MECH-010 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.FIXED, cmv:BillingBasis.CAPACITY ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0005, pack-base:CLM-B-0043 ;
    cm:sourceRef "report:PM-010" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Ongoing platform plus service bundle.\", \"formula\": null, \"normalization\": \"Subscription describes cadence and entitlement more than the underlying metering basis.\", \"provider_client_economics\": \"Predictable spend, access and governance; entitlement definition is critical.\", \"source_basis\": [\"BB-RECURRING\", \"BB-CAPACITY\"]}"^^rdf:JSON .

pack-base:PM-011 a skos:Concept ;
    skos:notation "PM-011" ;
    skos:prefLabel "Per-transaction or per-unit"@en ;
    skos:altLabel "unit pricing"@en, "per-unit"@en ;
    skos:definition "The fee equals the number of completed units multiplied by a unit price."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-012, pack-base:PM-015 ;
    cm:billingBasis cmv:BillingBasis.OUTPUT ;
    cm:calculationMethod cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0047 ;
    cm:sourceRef "report:PM-011" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Contract reviews, subpoenas, document review, RFPs, matters.\", \"formula\": \"F = Q * p\", \"provider_client_economics\": \"Aligns price to activity; provider assumes productivity risk. Requires a unit definition.\", \"source_basis\": [\"BB-OUTPUT\"]}"^^rdf:JSON .

pack-base:PM-012 a skos:Concept ;
    skos:notation "PM-012" ;
    skos:prefLabel "Per-document, per-contract or per-matter"@en ;
    skos:altLabel "per-document"@en, "per-contract"@en, "per-matter"@en ;
    skos:definition "Output pricing using a specialized unit such as a document, a contract or a matter."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:broader pack-base:PM-011 ;
    skos:related pack-base:PM-015 ;
    cm:billingBasis cmv:BillingBasis.OUTPUT ;
    cm:calculationMethod cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-012" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Document review, contract abstraction, contracting managed services.\", \"formula\": null, \"provider_client_economics\": \"Highly measurable but vulnerable to complexity heterogeneity.\", \"source_basis\": [\"BB-OUTPUT\"]}"^^rdf:JSON .

pack-base:PM-013 a skos:Concept ;
    skos:notation "PM-013" ;
    skos:prefLabel "Unit consumption"@en ;
    skos:altLabel "consumption pricing"@en, "metered pricing"@en ;
    skos:definition "Charges scale with metered consumption of a technology or service."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-030, pack-base:MECH-009 ;
    cm:billingBasis cmv:BillingBasis.USAGE, cmv:BillingBasis.OUTPUT ;
    cm:calculationMethod cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-013" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Processing, hosting, transactions, workflow runs.\", \"formula\": \"Fee = Sum_i(Usage_i * MeterRate_i)\", \"provider_client_economics\": \"Spend scales with use; less protection for the client budget if demand spikes.\", \"source_basis\": [\"BB-USAGE\", \"BB-OUTPUT\"]}"^^rdf:JSON .

pack-base:PM-014 a skos:Concept ;
    skos:notation "PM-014" ;
    skos:prefLabel "Tiered volume pricing"@en ;
    skos:altLabel "tiered pricing"@en, "volume tiers"@en ;
    skos:definition "A unit or usage rate that changes as volume crosses defined thresholds."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-V03, pack-base:CL-V04, pack-base:PM-011 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.OUTPUT, cmv:BillingBasis.USAGE ;
    cm:calculationMethod cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0043 ;
    cm:caveat "The report's supporting citation for this statement is not in its evidence register; add a registered source before relying on it."@en ;
    cm:sourceRef "report:PM-014" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"High-volume repeatable services.\", \"formula\": null, \"normalization\": \"Tiered pricing modifies a unit or usage rate.\", \"provider_client_economics\": \"Lower marginal rate at scale; incentivizes consolidation and commitment; can create threshold gaming.\", \"source_basis\": [\"BB-OUTPUT\", \"BB-USAGE\"]}"^^rdf:JSON .

pack-base:PM-015 a skos:Concept ;
    skos:notation "PM-015" ;
    skos:prefLabel "Complexity-weighted unit pricing"@en ;
    skos:altLabel "weighted units"@en, "complexity bands"@en ;
    skos:definition "Raw units are converted to weighted units by complexity band before a unit price is applied."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-011, pack-base:PM-012 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.OUTPUT ;
    cm:calculationMethod cmv:CalculationMethod.WEIGHTED_UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:prevalence cmv:Prevalence.UNVERIFIED ;
    cm:claim pack-base:CLM-B-0043, pack-base:CLM-B-0051 ;
    cm:caveat "Commercially sensible and consistent with unit-cost approaches; not proven universal."@en, "The report's supporting citation for this statement is not in its evidence register; add a registered source before relying on it."@en ;
    cm:sourceRef "report:PM-015" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Contracts, matters or tickets varying materially in effort or risk.\", \"formula\": null, \"normalization\": \"Complexity weighting modifies the unit definition or rate.\", \"provider_client_economics\": \"Better cost-to-price alignment but requires defensible classification and audit controls.\", \"source_basis\": [\"BB-OUTPUT\"]}"^^rdf:JSON .

pack-base:PM-016 a skos:Concept ;
    skos:notation "PM-016" ;
    skos:prefLabel "Milestone fee"@en ;
    skos:altLabel "milestone payment"@en ;
    skos:definition "Payments fall due on completion or acceptance of defined milestones."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-017, pack-base:PM-018, pack-base:PM-029 ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_PROJECT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-016" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Technology deployments, migrations, transformation.\", \"formula\": \"Fee = Sum_j(MilestonePayment_j)\", \"provider_client_economics\": \"Links payment to progress; acceptance criteria become key.\", \"source_basis\": [\"BB-MILESTONE\"]}"^^rdf:JSON .

pack-base:PM-017 a skos:Concept ;
    skos:notation "PM-017" ;
    skos:prefLabel "Phase-based fee"@en ;
    skos:altLabel "phase-by-phase pricing"@en, "phased fee"@en ;
    skos:definition "Separately priced phases, allowing scope to be contained and the work repriced at phase checkpoints."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-016, pack-base:PM-006 ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_PROJECT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:sourceRef "report:PM-017" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Discovery, design, build, migration, run.\", \"formula\": null, \"provider_client_economics\": \"Contains scope risk within phases; supports repricing at phase checkpoints.\", \"source_basis\": [\"BB-MILESTONE\", \"BB-FIXED\"]}"^^rdf:JSON .

pack-base:PM-018 a skos:Concept ;
    skos:notation "PM-018" ;
    skos:prefLabel "Deliverable-based fee"@en ;
    skos:altLabel "deliverable pricing"@en ;
    skos:definition "Fees tied to defined deliverables and their acceptance."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-016 ;
    cm:billingBasis cmv:BillingBasis.FIXED, cmv:BillingBasis.OUTPUT ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_PROJECT, cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-018" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Playbooks, datasets, migrated repository, reports.\", \"formula\": null, \"provider_client_economics\": \"Strong output alignment; acceptance ambiguity can create disputes.\", \"source_basis\": [\"BB-MILESTONE\", \"BB-OUTPUT\"]}"^^rdf:JSON .

pack-base:PM-019 a skos:Concept ;
    skos:notation "PM-019" ;
    skos:prefLabel "Cost-plus"@en ;
    skos:altLabel "cost plus markup"@en, "cost plus fee"@en ;
    skos:definition "The fee equals eligible provider cost plus a markup or a fixed fee."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-P09, pack-base:CL-D09 ;
    cm:billingBasis cmv:BillingBasis.COST ;
    cm:calculationMethod cmv:CalculationMethod.COST_PLUS ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0003 ;
    cm:sourceRef "report:PM-019" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Highly uncertain transformation or pass-through work.\", \"formula\": \"F = C * (1 + m) or F = C + Fee\", \"provider_client_economics\": \"Client bears cost risk; provider receives protected economics; weak efficiency incentive unless supplemented.\", \"source_basis\": [\"BB-COST\"]}"^^rdf:JSON .

pack-base:PM-020 a skos:Concept ;
    skos:notation "PM-020" ;
    skos:prefLabel "Capped time and materials"@en ;
    skos:altLabel "capped T&M"@en, "capped hourly"@en ;
    skos:definition "Time-based fees subject to a contractual maximum."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:broader pack-base:PM-001 ;
    skos:related pack-base:PM-001, pack-base:PM-021 ;
    cm:billingBasis cmv:BillingBasis.TIME ;
    cm:calculationMethod cmv:CalculationMethod.TIME ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:PM-020" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Uncertain work where the client requires a maximum exposure.\", \"formula\": null, \"provider_client_economics\": \"Provider bears incremental downside above the cap unless scope changes; client enjoys an upper bound.\", \"source_basis\": [\"BB-TIME\"]}"^^rdf:JSON .

pack-base:PM-021 a skos:Concept ;
    skos:notation "PM-021" ;
    skos:prefLabel "Not-to-exceed"@en ;
    skos:altLabel "NTE"@en, "fee ceiling"@en ;
    skos:definition "A contractual maximum applied to an underlying time, output or cost fee."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-020 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.TIME, cmv:BillingBasis.OUTPUT, cmv:BillingBasis.COST ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0043 ;
    cm:sourceRef "report:PM-021" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Projects and matters.\", \"formula\": null, \"normalization\": \"Not-to-exceed modifies an underlying time, cost or unit fee; it is a modifier, not an independent basis.\", \"provider_client_economics\": \"Economically similar to capped time and materials; not a separate foundational basis.\", \"source_basis\": []}"^^rdf:JSON .

pack-base:PM-022 a skos:Concept ;
    skos:notation "PM-022" ;
    skos:prefLabel "Portfolio or bundled fixed fee"@en ;
    skos:altLabel "portfolio pricing"@en, "bundled fixed fee"@en ;
    skos:definition "A fixed fee covering a portfolio of matters, contracts or transactions rather than each one individually."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-006 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.FIXED ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING, cmv:CalculationMethod.FIXED_PROJECT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:claim pack-base:CLM-B-0043 ;
    cm:caveat "The report's supporting citation for this statement is not in its evidence register; add a registered source before relying on it."@en ;
    cm:sourceRef "report:PM-022" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Repetitive matters, litigation portfolios, contract portfolios.\", \"formula\": null, \"normalization\": \"Portfolio pricing changes scope aggregation and risk pooling.\", \"provider_client_economics\": \"Diversifies matter-level variance if the portfolio is sufficiently broad; concentration risk remains.\", \"source_basis\": [\"BB-FIXED\"]}"^^rdf:JSON .

pack-base:PM-023 a skos:Concept ;
    skos:notation "PM-023" ;
    skos:prefLabel "Hybrid fixed plus variable"@en ;
    skos:altLabel "base plus overage"@en, "base plus variable"@en ;
    skos:definition "A recurring fixed charge for readiness or an included allowance, plus a metered charge for consumption beyond it."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-R10, pack-base:CL-V01, pack-base:CL-V02, pack-base:MECH-008 ;
    cm:billingBasis cmv:BillingBasis.FIXED, cmv:BillingBasis.OUTPUT, cmv:BillingBasis.USAGE ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING, cmv:CalculationMethod.ALLOWANCE_OVERAGE ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0008 ;
    cm:sourceRef "report:PM-023" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Managed services with base capacity or governance and overage.\", \"formula\": null, \"provider_client_economics\": \"Separates fixed readiness cost from variable consumption; often strong alignment for uncertain demand.\", \"source_basis\": [\"BB-RECURRING\", \"BB-FIXED\", \"BB-OUTPUT\", \"BB-USAGE\"]}"^^rdf:JSON .

pack-base:PM-024 a skos:Concept ;
    skos:notation "PM-024" ;
    skos:prefLabel "Value or outcome pricing"@en ;
    skos:altLabel "outcome-based pricing"@en, "value pricing"@en ;
    skos:definition "The fee is linked by formula to a defined result, saving or recovery."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-026, pack-base:MECH-005 ;
    cm:billingBasis cmv:BillingBasis.OUTCOME ;
    cm:calculationMethod cmv:CalculationMethod.OUTCOME_ADJUSTMENT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:claim pack-base:CLM-B-0006, pack-base:CLM-B-0041 ;
    cm:sourceRef "report:PM-024" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Work where an objective business result can be measured.\", \"formula\": \"Formula linked to outcome\", \"provider_client_economics\": \"Can align incentives but requires a measurable outcome, causation and a baseline; creates revenue volatility.\", \"source_basis\": [\"BB-OUTCOME\"]}"^^rdf:JSON .

pack-base:PM-025 a skos:Concept ;
    skos:notation "PM-025" ;
    skos:prefLabel "Performance incentive or bonus"@en ;
    skos:altLabel "performance fee"@en, "incentive fee"@en ;
    skos:definition "An incentive added to a base model that adjusts consideration around measured performance."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-P02, pack-base:PM-033 ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0006 ;
    cm:sourceRef "report:PM-025" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"SLA improvement, turnaround, quality, savings milestones.\", \"formula\": null, \"provider_client_economics\": \"Adds upside or downside around a base fee. Performance metric and controllability are essential.\", \"source_basis\": []}"^^rdf:JSON .

pack-base:PM-026 a skos:Concept ;
    skos:notation "PM-026" ;
    skos:prefLabel "Gain-share or verified savings"@en ;
    skos:altLabel "gain-share"@en, "savings share"@en ;
    skos:definition "The provider earns a share of verified savings measured against an auditable baseline."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:CL-P07, pack-base:MECH-007 ;
    cm:billingBasis cmv:BillingBasis.OUTCOME ;
    cm:calculationMethod cmv:CalculationMethod.OUTCOME_ADJUSTMENT ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.DOCUMENTED_SPECIALIZED ;
    cm:claim pack-base:CLM-B-0006 ;
    cm:sourceRef "report:PM-026" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Spend reduction, process savings, cost avoidance where the baseline is auditable.\", \"formula\": null, \"provider_client_economics\": \"Strong incentive alignment but baseline and attribution disputes can be severe.\", \"source_basis\": [\"BB-OUTCOME\"]}"^^rdf:JSON .

pack-base:PM-027 a skos:Concept ;
    skos:notation "PM-027" ;
    skos:prefLabel "Success or contingent fee"@en ;
    skos:altLabel "contingent fee"@en, "success fee"@en ;
    skos:definition "All or part of the fee depends on achieving a defined result, such as a recovery."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-024, pack-base:PM-032 ;
    cm:billingBasis cmv:BillingBasis.OUTCOME ;
    cm:calculationMethod cmv:CalculationMethod.OUTCOME_ADJUSTMENT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:caveat "Legal restrictions depend on jurisdiction, provider type and matter type; legal review is required before use."@en ;
    cm:sourceRef "report:PM-027" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Recoveries, litigation or a measurable result, where lawful.\", \"formula\": null, \"provider_client_economics\": \"Provider bears outcome risk for potential upside; legal restrictions depend on jurisdiction and provider.\", \"source_basis\": [\"BB-OUTCOME\"]}"^^rdf:JSON .

pack-base:PM-028 a skos:Concept ;
    skos:notation "PM-028" ;
    skos:prefLabel "Technology-enabled managed service"@en ;
    skos:altLabel "tech-enabled managed service"@en ;
    skos:definition "A service that bundles labor, platform, process and risk transfer, usually as a recurring charge with output or usage elements."@en ;
    skos:inScheme pack-base:scheme.pricing_models ;
    skos:related pack-base:PM-007 ;
    cm:kind "modifier" ;
    cm:billingBasis cmv:BillingBasis.FIXED, cmv:BillingBasis.OUTPUT, cmv:BillingBasis.USAGE ;
    cm:calculationMethod cmv:CalculationMethod.FIXED_RECURRING, cmv:CalculationMethod.UNIT_OUTPUT ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0043 ;
    cm:sourceRef "report:PM-028" ;
    cm:status "active" ;
    cm:attributes "{\"applications\": \"Contracting, eDiscovery, operations, compliance.\", \"formula\": null, \"normalization\": \"Managed service describes accountability and delivery architecture, not necessarily the billing basis; technology-enabled service describes delivery composition.\", \"provider_client_economics\": \"Bundles labor, platform, process and risk transfer; economically a configuration rather than a unique billing basis.\", \"source_basis\": [\"BB-RECURRING\", \"BB-OUTPUT\", \"BB-USAGE\"]}"^^rdf:JSON .

pack-base:PM-029 a skos:Concept ;
    skos:notation "PM-029" ;
