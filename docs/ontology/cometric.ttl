    cm:explanation "Professional-responsibility and provider-status rules control whether a contingency fee is available to a nonlawyer provider delivering regulated legal representation."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"equals\": \"NONLAW_ALSP\", \"path\": \"parties[*].provider_type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0027, pack-alsp:CLM-A-0028, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:compatibility-rules" .

pack-alsp:RULE-011 a cm:Rule ;
    skos:notation "RULE-011" ;
    cm:pack pack-alsp:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_AI_PERSONAL_DATA" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "An AI supplier processing personal data requires review of data roles, security and subprocessors under applicable law."@en ;
    cm:explanation "Where an AI supplier processes personal data, data-protection roles, security and subprocessors must be evaluated under applicable law."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-base:CLM-B-0019 ;
    cm:sourceRef "report:RULE-011" .

pack-alsp:RULE-012 a cm:Rule ;
    skos:notation "RULE-012" ;
    cm:pack pack-alsp:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "RULE_CONTINGENT_LEGAL_FEE" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Outcome-linked consideration on a legal service requires legal review of jurisdiction, provider and matter restrictions."@en ;
    cm:explanation "Contingent legal fees are subject to jurisdiction, provider and matter restrictions that require legal validation."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"exists\": true, \"path\": \"services[*].service_category\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-alsp:CLM-A-0027, pack-alsp:CLM-A-0029 ;
    cm:sourceRef "report:RULE-012" .

pack-alsp:RULE-016 a cm:Rule ;
    skos:notation "RULE-016" ;
    cm:pack pack-alsp:pack ;
    cm:kind "reasoning" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "RULE_FUTURE_EFFECTIVE_REGULATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "The commercial term may span a regulatory change date; future-effective obligations require review in contract and cost assumptions."@en ;
    cm:explanation "Where a commercial term spans a regulatory change date, future-effective obligations (for example UK material third-party reporting rules and the updated SS2/21 from March 18, 2027) must be included in contract and cost assumptions."@en ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0016, pack-base:CLM-B-0017 ;
    cm:sourceRef "report:RULE-016" .

pack-alsp:ALSP-R-001 a cm:Rule ;
    skos:notation "ALSP-R-001" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "CONTINGENT_FEE_REGULATED_WORK" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Outcome-based consideration on legal work requires legal review for the provider type and jurisdiction."@en ;
    cm:explanation "US model rules regulate contingent fees and state adoption varies; in England and Wales, conditional and damages-based agreements are subject to their own rules, including the Damages-Based Agreements Regulations 2013."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"in\": [\"CONTRACTS\", \"EDISCOVERY\", \"DOCUMENT_REVIEW\", \"LEGAL_OPERATIONS\", \"REGULATORY_CHANGE\", \"FLEXIBLE_RESOURCING\"], \"path\": \"services[*].service_category\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-alsp:CLM-A-0027, pack-alsp:CLM-A-0029, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-002 a cm:Rule ;
    skos:notation "ALSP-R-002" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "CONTINGENT_FEE_REGULATED_LAW_FIRM" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Contingent or outcome fees for a regulated law firm require legal review."@en ;
    cm:explanation "Regulated law firms are subject to state ethics rules (US) or regulator requirements (England and Wales), including fee reasonableness and contingent-fee rules."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"equals\": \"REGULATED_LAW_FIRM\", \"path\": \"parties[*].provider_type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-alsp:CLM-A-0027, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-003 a cm:Rule ;
    skos:notation "ALSP-R-003" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "OUTCOME_FEE_NONLAW_ALSP" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Outcome fees for a non-law-firm ALSP require legal review where they are tied to legal representation."@en ;
    cm:explanation "A non-law-firm ALSP must avoid unauthorized practice and its scope depends on reserved or nonreserved activity; outcome fees tied to legal representation may be constrained."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"equals\": \"NONLAW_ALSP\", \"path\": \"parties[*].provider_type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0013, pack-alsp:CLM-A-0047, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-004 a cm:Rule ;
    skos:notation "ALSP-R-004" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "OUTCOME_FEE_LICENSED_BODY" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Outcome fees for a licensed body require legal review because regulated legal duties remain."@en ;
    cm:explanation "Licensed bodies have a broader ownership architecture, but regulated legal duties remain; in the US such structures are available only in certain jurisdictions."@en ;
    cm:condition "{\"all\": [{\"any\": [{\"equals\": \"OUTCOME\", \"path\": \"arrangement_versions[*].components[*].billing_basis\"}, {\"equals\": \"OUTCOME_ADJUSTMENT\", \"path\": \"arrangement_versions[*].components[*].calculation_method\"}]}, {\"equals\": \"LICENSED_BODY\", \"path\": \"parties[*].provider_type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0030, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-005 a cm:Rule ;
    skos:notation "ALSP-R-005" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "FEE_SHARING_NONLAW_PROVIDER" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "An arrangement combining a regulated law firm with a non-law-firm provider may involve fee sharing and requires legal review."@en ;
    cm:explanation "US Model Rule 5.4 generally bars sharing legal fees with nonlawyers, with state variation; solicitor rules in England and Wales require disclosure of fee-sharing arrangements and referral interests."@en ;
    cm:condition "{\"all\": [{\"equals\": \"REGULATED_LAW_FIRM\", \"path\": \"parties[*].provider_type\"}, {\"in\": [\"NONLAW_ALSP\", \"FLEXIBLE_TALENT\", \"LEGAL_TECH_VENDOR\", \"MANAGED_SERVICES_PROVIDER\"], \"path\": \"parties[*].provider_type\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-alsp:CLM-A-0028, pack-alsp:CLM-A-0029, pack-alsp:CLM-A-0031, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:us-constraints" .

pack-alsp:ALSP-R-006 a cm:Rule ;
    skos:notation "ALSP-R-006" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "SUBCONTRACTED_OR_CROSS_BORDER_DELIVERY" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Subcontracted delivery requires review of supervision, data handling and any regulated or cross-border outsourcing obligations."@en ;
    cm:explanation "Subcontractor rights add supervision and data risk; regulated and cross-border outsourcing structures require legal review before being treated as permissible."@en ;
    cm:condition "{\"equals\": \"SUBCONTRACTOR\", \"path\": \"parties[*].role\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-base:CLM-B-0019, pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-007 a cm:Rule ;
    skos:notation "ALSP-R-007" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "REGULATED_CLIENT_OUTSOURCING" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "Services to a financial-services client require review of outsourcing, operational-resilience, audit, exit and third-party reporting obligations."@en ;
    cm:explanation "Financial-services clients remain responsible for third-party and outsourcing risk; UK material third-party reporting rules and updated SS2/21 expectations apply from March 18, 2027. The client's sector is not an engagement path, so this rule is not machine-evaluable."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-base:CLM-B-0015, pack-base:CLM-B-0016, pack-base:CLM-B-0017, pack-base:CLM-B-0018 ;
    cm:sourceRef "report:outsourcing-constraints" .

pack-alsp:ALSP-R-008 a cm:Rule ;
    skos:notation "ALSP-R-008" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "AI_PERSONAL_DATA_REVIEW" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "Technology or automation is declared; if personal data is processed, data-protection roles, subprocessors, security, audit rights and end-of-contract data handling require review."@en ;
    cm:explanation "UK data-protection AI contracting guidance and financial-services AI good practice create real cost drivers for AI-enabled services. The engagement has no personal-data path, so the rule fires on declared technology use and its message is conditional."@en ;
    cm:condition "{\"any\": [{\"exists\": true, \"path\": \"descriptors.automation_benefit\"}, {\"exists\": true, \"path\": \"descriptors.technology_treatment\"}]}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-base:CLM-B-0019, pack-base:CLM-B-0020 ;
    cm:sourceRef "report:outsourcing-constraints" .

pack-alsp:ALSP-R-009 a cm:Rule ;
    skos:notation "ALSP-R-009" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "FLEXIBLE_TALENT_SUPERVISION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A flexible-talent provider is declared; review allocation of lawyer supervision."@en ;
    cm:explanation "Flexible-talent providers often supply talent rather than law-firm representation; resource pricing is straightforward but supervision allocation is critical."@en ;
    cm:condition "{\"equals\": \"FLEXIBLE_TALENT\", \"path\": \"parties[*].provider_type\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0013, pack-alsp:CLM-A-0047 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-010 a cm:Rule ;
    skos:notation "ALSP-R-010" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "LEGAL_TECH_DATA_REGULATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A legal-technology vendor is declared; review applicable data and AI regulation."@en ;
    cm:explanation "Usage and subscription models are generally easier for technology vendors, but data and AI regulation applies."@en ;
    cm:condition "{\"equals\": \"LEGAL_TECH_VENDOR\", \"path\": \"parties[*].provider_type\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0047 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-011 a cm:Rule ;
    skos:notation "ALSP-R-011" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "true"^^xsd:boolean ;
    cm:code "MANAGED_SERVICES_ADVICE_SEPARATION" ;
    cm:severity cmv:Severity.WARNING ;
    cm:message "A legal managed-services provider is declared; review whether the contract must separate legal advice from processing and operations."@en ;
    cm:explanation "Legal managed-services providers may combine regulated and nonregulated functions; the provider entity and work type matter."@en ;
    cm:condition "{\"equals\": \"MANAGED_SERVICES_PROVIDER\", \"path\": \"parties[*].provider_type\"}"^^rdf:JSON ;
    cm:evidenceClass cmv:EvidenceClass.C_INFERENCE ;
    cm:claim pack-alsp:CLM-A-0047 ;
    cm:sourceRef "report:provider-type-matrix" .

pack-alsp:ALSP-R-012 a cm:Rule ;
    skos:notation "ALSP-R-012" ;
    cm:pack pack-alsp:pack ;
    cm:kind "constraint" ;
    cm:evaluable "false"^^xsd:boolean ;
    cm:code "UK_DAMAGES_BASED_AGREEMENT" ;
    cm:severity cmv:Severity.APPROVAL_REQUIRED ;
    cm:message "A damages-based or conditional fee agreement in England and Wales requires legal review against statutory requirements."@en ;
    cm:explanation "Damages-based agreements are governed by statutory requirements including the Damages-Based Agreements Regulations 2013, and applicability depends on matter type and agreement structure. Jurisdiction is not an engagement path, so this rule is not machine-evaluable."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:claim pack-alsp:CLM-A-0048 ;
    cm:sourceRef "report:uk-constraints" .

pack-alsp:CLM-A-0001 a cm:Claim ;
    skos:notation "CLM-A-0001" ;
    cm:pack pack-alsp:pack ;
    cm:statement "Publisher research estimated the 2023 ALSP market at $28.5 billion."@en ;
