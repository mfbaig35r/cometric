    cm:attributes "{\"computed_by\": \"effective_client_unit_price\", \"family\": \"commercial_health\", \"formula\": \"Total client fee / completed normalized units\", \"interpretation\": \"A rising value may indicate poor economics.\", \"limitation\": \"Unit normalization required.\", \"requires\": null, \"unit_period\": null}"^^rdf:JSON .

pack-base:CHI-003 a skos:Concept ;
    skos:notation "CHI-003" ;
    skos:prefLabel "Capacity utilization"@en ;
