pack-base:BB-MILESTONE a skos:Concept ;
    skos:notation "BB-MILESTONE" ;
    skos:prefLabel "Milestone or deliverable"@en ;
    skos:definition "Billing basis whose economic object purchased is: completion or acceptance event. Fundamental calculation: Fee = Sum(MilestonePayment_j)."@en ;
