pack-alsp:CLM-A-0045 a cm:Claim ;
    skos:notation "CLM-A-0045" ;
    cm:pack pack-alsp:pack ;
    cm:statement "At least one flexible-talent provider documents secondment and reserved or ad hoc engagement models."@en ;
    cm:evidenceClass cmv:EvidenceClass.A_DIRECT ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:source pack-alsp:E007 ;
