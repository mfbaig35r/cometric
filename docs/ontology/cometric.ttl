pack-base:BB-FIXED a skos:Concept ;
    skos:notation "BB-FIXED" ;
    skos:prefLabel "Fixed entitlement"@en ;
    skos:definition "Billing basis whose economic object purchased is: defined scope or obligation regardless of effort. Fundamental calculation: Contractually fixed fee."@en ;
    skos:inScheme pack-base:scheme.billing_bases ;
