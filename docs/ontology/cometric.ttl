    cm:sourceRef "report:FM-016" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"gross_profit\", \"family\": \"financial\", \"formula\": \"GP = Revenue - DirectDeliveryCost\", \"limitation\": \"'Direct' must be defined; one professional-services software definition uses revenue less labor and direct or reimbursable expenses.\", \"requires\": null, \"unit_period\": \"currency\"}"^^rdf:JSON .

pack-base:FM-017 a skos:Concept ;
    skos:notation "FM-017" ;
    skos:prefLabel "Gross margin"@en ;
    skos:definition "Gross profit as a share of revenue."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0023 ;
    cm:sourceRef "report:FM-017" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"gross_margin\", \"family\": \"financial\", \"formula\": \"GM = GP / Revenue\", \"limitation\": \"Not the same as markup.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-018 a skos:Concept ;
    skos:notation "FM-018" ;
    skos:prefLabel "Contribution profit"@en ;
    skos:definition "Revenue less variable costs and engagement-avoidable fixed costs."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0021 ;
    cm:caveat "Cometric's contribution_profit subtracts margin layers (DIRECT_DELIVERY and ENGAGEMENT_AVOIDABLE); it equals FM-018 only when all direct delivery costs are avoidable. The engine reports unavoidable direct cost separately so FM-018 can be reconstructed."@en ;
    cm:sourceRef "report:FM-018" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"contribution_profit\", \"family\": \"financial\", \"formula\": \"CP = Revenue - VariableCosts - EngagementAvoidableFixedCosts\", \"limitation\": \"Scope of 'avoidable' must be explicit.\", \"requires\": null, \"unit_period\": \"currency\"}"^^rdf:JSON .

pack-base:FM-019 a skos:Concept ;
    skos:notation "FM-019" ;
    skos:prefLabel "Contribution margin"@en ;
    skos:definition "Contribution profit as a share of revenue."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0021 ;
    cm:sourceRef "report:FM-019" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"contribution_margin\", \"family\": \"financial\", \"formula\": \"CM = CP / Revenue\", \"limitation\": \"Useful for incremental decisions; not a full P&L.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-020 a skos:Concept ;
    skos:notation "FM-020" ;
    skos:prefLabel "Operating profit"@en ;
    skos:definition "Revenue minus direct, allocated operating and overhead expenses as defined."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0021 ;
    cm:sourceRef "report:FM-020" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": null, \"family\": \"financial\", \"formula\": null, \"limitation\": \"Allocation policy can dominate the result.\", \"requires\": null, \"unit_period\": \"currency\"}"^^rdf:JSON .

pack-base:FM-021 a skos:Concept ;
    skos:notation "FM-021" ;
    skos:prefLabel "Markup"@en ;
    skos:definition "Price less cost, as a share of cost."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0023 ;
    cm:sourceRef "report:FM-021" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"markup\", \"family\": \"financial\", \"formula\": \"(Price - Cost) / Cost\", \"limitation\": \"A 25% markup is not a 25% margin.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-022 a skos:Concept ;
    skos:notation "FM-022" ;
    skos:prefLabel "Margin"@en ;
    skos:definition "Price less cost, as a share of price."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:claim pack-base:CLM-B-0023 ;
    cm:sourceRef "report:FM-022" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"margin\", \"family\": \"financial\", \"formula\": \"(Price - Cost) / Price\", \"limitation\": \"A 25% margin implies a 33.33% markup.\", \"requires\": null, \"unit_period\": \"%\"}"^^rdf:JSON .

pack-base:FM-023 a skos:Concept ;
    skos:notation "FM-023" ;
    skos:prefLabel "Effective billing rate"@en ;
    skos:definition "Revenue attributable to labor divided by productive hours."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
    cm:prevalence cmv:Prevalence.ESTABLISHED_COMMON ;
    cm:sourceRef "report:FM-023" ;
    cm:status "active" ;
    cm:attributes "{\"computed_by\": \"effective_billing_rate\", \"family\": \"financial\", \"formula\": \"LaborRevenue / ProductiveHours\", \"limitation\": \"For fixed fees, may be retrospective.\", \"requires\": null, \"unit_period\": \"currency / hour\"}"^^rdf:JSON .

pack-base:FM-024 a skos:Concept ;
    skos:notation "FM-024" ;
    skos:prefLabel "Revenue per FTE"@en ;
    skos:definition "Revenue divided by average delivery FTEs."@en ;
    skos:inScheme pack-base:scheme.metrics ;
    cm:evidenceClass cmv:EvidenceClass.B_CORROBORATED ;
